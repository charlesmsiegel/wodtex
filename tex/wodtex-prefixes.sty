\tl_new:N \l_wodtex_prefix_command_tl
\cs_new_protected:Npn \wodtex_prefix_scan: {
 \peek_catcode:NTF a {\wodtex_prefix_take:n} {
  \cs_if_exist:cTF{wodtex/prefix/\l_wodtex_prefix_command_tl}
   {\use:c{wodtex/prefix/\l_wodtex_prefix_command_tl}}
   {\regex_replace_once:nnN{\Am20}{}\l_wodtex_prefix_command_tl
    \cs_if_exist:cTF{mTwentyPublic\l_wodtex_prefix_command_tl}
     {\use:c{mTwentyPublic\l_wodtex_prefix_command_tl}}
     {\PackageError{wodtex}{WODTEX_E_UNKNOWN_COMMAND:~\l_wodtex_prefix_command_tl}{Check~the~template~prefix~and~component~name.}}}
 }
}
\cs_new_protected:Npn \wodtex_prefix_take:n #1 {
 \tl_put_right:Nn\l_wodtex_prefix_command_tl{#1}\wodtex_prefix_scan:
}
\cs_new_protected:Npn \wodtex_prefix_numeric:n #1 {
 \peek_meaning_remove:NTF 2 {
  \peek_meaning_remove:NTF 0
   {\tl_set:Nn\l_wodtex_prefix_command_tl{#120}\wodtex_prefix_scan:}
   {\use:c{wodtex/prefix-original/#1}{2}}
 }{\use:c{wodtex/prefix-original/#1}}
}
\clist_map_inline:nn{m,w,c,d,v,vva,wr,kote,kotek}{
 \cs_if_exist:cTF{#1}
  {\exp_args:Ncc\NewCommandCopy{wodtex/prefix-original/#1}{#1}}
  {\cs_new_protected:cpn{wodtex/prefix-original/#1}
    {\PackageError{wodtex}{WODTEX_E_UNKNOWN_COMMAND:~#1}{Use~a~known~template~prefix.}}}
 \cs_set_protected:cpn{#1}{\wodtex_prefix_numeric:n{#1}}
}
