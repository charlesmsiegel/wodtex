\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{wodtex-prefixes}[2026/10/02 explicit component style prefixes]
\RequirePackage{tex/wodtex-registry}
\ExplSyntaxOn
% Environment hooks run outside the environment group so only the host can
% suspend/reopen its body columns. The captured body selects a local style.
\cs_new_protected:Npn \wodtex_prefix_env:nnn #1#2#3 {
 \cs_if_exist:cTF {#2#3} {
  \str_if_eq:eeF{#2/\wodtexClassStyle}{m20/m20}{
   \PackageError{wodtex}{WODTEX_E_NAME_COLLISION:~#2#3}{A~package~already~defines~this~prefixed~environment.}}
 }{
  \str_case:nn {#3} {
   {sidebar}{\NewDocumentEnvironment{#2#3}{O{}m+b}
    {\def\wodtexActiveStyle{#1}\wodtexDispatchStyle{#1}{sidebar}{##1}{##2}{##3}}{}}
   {sidebarwide}{\NewDocumentEnvironment{#2#3}{O{}m+b}
    {\def\wodtexActiveStyle{#1}\wodtexDispatchStyle{#1}{sidebarwide}{##1}{##2}{##3}}{}}
   {table}{\NewDocumentEnvironment{#2#3}{O{}m+b}
    {\def\wodtexActiveStyle{#1}\wodtexDispatchStyle{#1}{booktable}{##1}{##2}{##3}}{}}
   {tablelead}{\NewDocumentEnvironment{#2#3}{+b}
    {\def\wodtexActiveStyle{#1}\wodtexDispatchStyle{#1}{tablelead}{##1}}{}}
   {statblock}{\NewDocumentEnvironment{#2#3}{+b}
    {\def\wodtexActiveStyle{#1}\wodtexDispatchStyle{#1}{statblock}{##1}}{}}
  }
  \str_if_eq:nnTF{#3}{table}
   {\AddToHook{env/#2#3/before}{\wodtexDispatchStyle{#1}{booktable-before}}
    \AddToHook{env/#2#3/after}{\wodtexDispatchStyle{#1}{booktable-after}}}
   {\AddToHook{env/#2#3/before}{\wodtexDispatchStyle{#1}{#3-before}}
    \AddToHook{env/#2#3/after}{\wodtexDispatchStyle{#1}{#3-after}}}
 }
}
\cs_new_protected:Npn \wodtex_prefix_style:nn #1#2 {
 \clist_map_inline:nn{sidebar,sidebarwide,table,tablelead,statblock}
  {\wodtex_prefix_env:nnn{#1}{#2}{##1}}
 \exp_args:Nc\NewDocumentCommand{wodtex/prefix/#2sidebarbreak}{O{page}}
  {\wodtexDispatchStyle{#1}{sidebarbreak}{##1}}
 \exp_args:Nc\NewDocumentCommand{wodtex/prefix/#2statentry}{m}
  {\group_begin:\def\wodtexActiveStyle{#1}\wodtexDispatchStyle{#1}{statentry}{##1}\group_end:}
 \exp_args:Nc\NewDocumentCommand{wodtex/prefix/#2artreserve}{O{}g}
  {\wodtexDispatchStyle{#1}{artreserve}{##1}{##2}}
 % Letter-only prefixes are ordinary control words. Numeric prefixes are
 % scanned below without changing document catcodes or losing accent macros.
 \regex_match:nnF{[0-9]}{#2}{
  \clist_map_inline:nn{sidebarbreak,statentry,artreserve}{
   \cs_if_exist:cTF{#2##1}{
    \PackageError{wodtex}{WODTEX_E_NAME_COLLISION:~#2##1}{A~package~already~defines~this~prefixed~command.}
   }{\cs_new_eq:cc{#2##1}{wodtex/prefix/#2##1}}
  }
 }
}
