\cs_new_protected:Npn\wodtexCrossPrepare#1{
 \prop_if_in:NnF\g_wodtex_cross_resources_prop{#1/path}{
  \group_begin:
  \str_if_eq:nnTF{#1}{m20}{
   \cs_if_exist:NTF\mTwentyFontPath
    {\wodtex_cross_put:nnn{#1}{path}{\mTwentyFontPath}}
    {\wodtex_cross_put:nnn{#1}{path}{\mTwentyBuildFontPath}}
   \cs_if_exist:NTF\mTwentyAssetPath
    {\wodtex_cross_put:nnn{#1}{assets}{\mTwentyAssetPath}}
    {\wodtex_cross_put:nnn{#1}{assets}{\mTwentyBuildAssetPath}}
   \wodtex_cross_put:nnn{#1}{body}{GOUDOS.TTF}
   \wodtex_cross_put:nnn{#1}{bold}{GOUDOSB_0.TTF}
   \wodtex_cross_put:nnn{#1}{italic}{GOUDOSI_0.TTF}
   \wodtex_cross_put:nnn{#1}{bolditalic}{GOUDOSI_0.TTF}
   \wodtex_cross_put:nnn{#1}{heading}{abbess-regular.ttf}
   \wodtex_cross_put:nnn{#1}{size}{10}\wodtex_cross_put:nnn{#1}{leading}{10}
   \wodtex_cross_put:nnn{#1}{heading-size}{18}\wodtex_cross_put:nnn{#1}{heading-leading}{18}
   \definecolor{wodtexCrossProfileAccent}{cmyk}{.8549,1,.2161,.1239}
  }{
   \def\wodtexCrossProfileId{#1}
   \InputIfFileExists{wodtex-profile-#1.tex}{}{
    \InputIfFileExists{profiles/\wodtexCrossProfileId.tex}{}{
     \PackageError{wodtex}{WODTEX_E_PROFILE_MISSING:~#1}{Install~the~selected~component~profile.}}}
   \wodtex_cross_put:nnn{#1}{path}{\wodtexResourceRoot#1/}
   \clist_map_inline:nn{body/BodyFont,bold/BoldFont,italic/ItalicFont,bolditalic/BoldItalicFont,heading/HeadingFace,size/BodySize,leading/BodyLeading,heading-size/HeadingSize,heading-leading/HeadingLeading}{
    \seq_set_split:Nnn\l_tmpa_seq{/}{##1}
    \exp_args:Nxx\wodtex_cross_put:nnn{#1}{\seq_item:Nn\l_tmpa_seq{1}}{\use:c{wodtex\seq_item:Nn\l_tmpa_seq{2}}}}
   \colorlet{wodtexCrossProfileAccent}{wodtexAccent}
  }
  \convertcolorspec{named}{wodtexCrossProfileAccent}{rgb}\wodtexCrossAccentSpec
  \wodtex_cross_put:nnn{#1}{accent}{\wodtexCrossAccentSpec}
  \group_end:
  \clist_map_inline:nn{body,bold,italic,bolditalic,heading}{
   \IfFileExists{\wodtexCrossField{#1}{path}\wodtexCrossField{#1}{##1}}{}{
    \PackageError{wodtex}{WODTEX_E_RESOURCE_MISSING:~#1/##1}{Prepare~the~component~resources~and~configure~their~paths.}}}
  \directlua{luaotfload.add_fallback("wodtex-cross-#1-display",{"[\luaescapestring{\wodtexCrossField{#1}{path}\wodtexCrossField{#1}{body}}]:mode=node;"})}
  \exp_args:Nc\newfontfamily{wodtexCrossBody#1}{\wodtexCrossField{#1}{body}}[
   Path={\wodtexCrossField{#1}{path}},BoldFont={\wodtexCrossField{#1}{bold}},
   ItalicFont={\wodtexCrossField{#1}{italic}},BoldItalicFont={\wodtexCrossField{#1}{bolditalic}}]
  \exp_args:Nc\newfontfamily{wodtexCrossHeading#1}{\wodtexCrossField{#1}{heading}}[
   Path={\wodtexCrossField{#1}{path}},HyphenChar=None,RawFeature={fallback=wodtex-cross-#1-display}]
 }
}
\cs_new_protected:Npn\wodtexCrossSelect#1{
 \wodtexCrossPrepare{#1}\def\wodtexCrossStyle{#1}\def\wodtexActiveStyle{#1}
 \wodtexCrossContexttrue
 % Native aliases nested inside a foreign component must not reopen columns.
 \cs_if_exist:NT\mTwentyBodyBegin{\let\mTwentyBodyBegin\relax\let\mTwentyBodyEnd\relax}
 \cs_if_exist:NT\wodtexBodyBegin{\let\wodtexBodyBegin\relax\let\wodtexBodyEnd\relax}
 \use:c{wodtexCrossBody#1}\fontsize{\wodtexCrossField{#1}{size}bp}{\wodtexCrossField{#1}{leading}bp}\selectfont
 \parindent=18bp\parskip=0pt
 \definecolor{wodtexCrossAccent}{rgb}{\wodtexCrossField{#1}{accent}}
}
