}
\cs_new_protected:Npn\wodtexCrossOptionFor#1#2{
 \str_if_eq:eeF{#1}{\wodtexCrossComponent}{
  \PackageError{wodtex}{WODTEX_E_OPTION:~#2}{This~option~does~not~apply~to~the~selected~component.}}}
\keys_define:nn{wodtex/crossover}{
 id .tl_set:N=\l_wodtex_cross_id_tl,
 place .choice:,place/flow .code:n=\tl_set:Nn\l_wodtex_cross_place_tl{flow},
 place/here .code:n={\str_if_eq:eeT{\wodtexCrossComponent}{art}{
  \PackageError{wodtex}{WODTEX_E_POSITION_UNSUPPORTED}{Foreign~art~supports~flow~or~next-page~placement.}}
  \tl_set:Nn\l_wodtex_cross_place_tl{here}},
 place/next-page .code:n=\tl_set:Nn\l_wodtex_cross_place_tl{next-page},
 columns .choice:,
 columns/1 .code:n={\wodtexCrossOptionFor{sidebar}{columns}\int_set:Nn\l_wodtex_cross_columns_int{1}},
 columns/2 .code:n={\wodtexCrossOptionFor{sidebar}{columns}\int_set:Nn\l_wodtex_cross_columns_int{2}},
 breakable .choice:,
 breakable/true .code:n={\wodtexCrossOptionFor{sidebar}{breakable}\bool_set_true:N\l_wodtex_cross_breakable_bool},
 breakable/false .code:n={\wodtexCrossOptionFor{sidebar}{breakable}\bool_set_false:N\l_wodtex_cross_breakable_bool},
 breakable .default:n=true,
 head-rows .code:n={\wodtexCrossOptionFor{table}{head-rows}\int_set:Nn\l_wodtex_cross_head_int{#1}},
 image .code:n={\wodtexCrossOptionFor{art}{image}\tl_set:Nn\l_wodtex_cross_image_tl{#1}},
 caption .code:n={\wodtexCrossOptionFor{art}{caption}\tl_set:Nn\l_wodtex_cross_caption_tl{#1}},
 credit .code:n={\wodtexCrossOptionFor{art}{credit}\tl_set:Nn\l_wodtex_cross_credit_tl{#1}},
 alt .code:n={\wodtexCrossOptionFor{art}{alt}},role .choice:,
 role/decorative .code:n={\wodtexCrossOptionFor{art}{role}},role/meaningful .code:n={\wodtexCrossOptionFor{art}{role}},
 kind .choice:,
 kind/horizontal .code:n={\wodtexCrossOptionFor{art}{kind}\tl_set:Nn\l_wodtex_cross_kind_tl{horizontal}},
 kind/vertical .code:n={\wodtexCrossOptionFor{art}{kind}\tl_set:Nn\l_wodtex_cross_kind_tl{vertical}},
 position .code:n=\PackageError{wodtex}{WODTEX_E_POSITION_UNSUPPORTED}{Foreign~art~supports~flow~or~next-page~placement.},
 unknown .code:n=\PackageError{wodtex}{WODTEX_E_OPTION:~\l_keys_key_str}{Unsupported~crossover~component~option.}}
\cs_new_protected:Npn\wodtexCrossOptions#1#2{
 \def\wodtexCrossComponent{#1}
 \tl_clear:N\l_wodtex_cross_id_tl\tl_clear:N\l_wodtex_cross_image_tl
 \tl_clear:N\l_wodtex_cross_alias_id_tl
 \tl_clear:N\l_wodtex_cross_caption_tl\tl_clear:N\l_wodtex_cross_credit_tl
 \tl_set:Nn\l_wodtex_cross_place_tl{flow}\tl_set:Nn\l_wodtex_cross_kind_tl{horizontal}
 \int_set:Nn\l_wodtex_cross_columns_int{1}\int_set:Nn\l_wodtex_cross_head_int{1}
 \bool_set_true:N\l_wodtex_cross_breakable_bool\keys_set:nn{wodtex/crossover}{#2}
 \int_compare:nNnT{\l_wodtex_cross_head_int}<{0}{\PackageError{wodtex}{WODTEX_E_TABLE_HEADERS}{head-rows~cannot~be~negative.}}
 \tl_if_eq:NnT\l_wodtex_cross_place_tl{next-page}{
  \str_if_eq:nnT{#1}{table}{\bool_if:NT\l_wodtex_cross_contained_bool{
   \PackageError{wodtex}{WODTEX_E_CONTAINED_PLACEMENT}{A~contained~table~cannot~start~an~independent~page.}}}
  \clearpage}
 \stepcounter{wodtexCrossElement}\edef\wodtexCrossNumber{\thewodtexCrossElement}
 \bool_set_false:N\l_wodtex_cross_auto_id_bool
 \tl_if_empty:NT\l_wodtex_cross_id_tl{
  \bool_set_true:N\l_wodtex_cross_auto_id_bool
  \tl_set:Nx\l_wodtex_cross_id_tl{wodtex-cross-\wodtexCrossNumber}}
}
