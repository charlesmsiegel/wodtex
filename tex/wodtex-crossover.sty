% Internal multicols is one atomic box. Never ask the outer breakable frame
% to split it: that would discard overflow. Each explicit page fragment must
% fit the host page, including its title, insets and collected notes.
\cs_new_protected:Npn\wodtexCrossCheckFragment{
 \dim_compare:nNnT{\tcb@natheight}>{\textheight}{
  \PackageError{wodtex}{WODTEX_E_SIDEBAR_FRAGMENT_TOO_TALL}{Use~columns=1,~enable~one-column~breaking,~or~insert~sidebarbreak[page]~between~shorter~two-column~fragments.}}
 \wodtexCrossPlaceAtomic}
\cs_new_protected:Npn\wodtexCrossPlaceAtomic{
 \par\dim_compare:nNnT{\tcb@natheight}>{\pagegoal-\pagetotal}{\newpage}}
