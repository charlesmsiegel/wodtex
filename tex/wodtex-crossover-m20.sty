  \IfFileExists{\wodtexCrossField{m20}{assets}\wodtexCrossAsset.reference-template.pdf}{}{%
   \PackageError{wodtex}{WODTEX_E_RESOURCE_MISSING: m20/\wodtexCrossAsset}{Configure the corrected M20 artwork directory.}}}%
 \tcbset{boxrule=7bp,boxsep=0bp,left=18bp,right=18bp,top=5bp,bottom=10bp,
  toptitle=7.2bp,bottomtitle=5bp,center title,coltext=white,coltitle=wodtexCrossMageGold,
  fonttitle=\wodtexCrossHeading\mdseries,
  frame code={},interior code={},interior titled code={},
  underlay unbroken={\wodtexCrossMagePaint},underlay first={\wodtexCrossMagePaint},
  underlay middle={\wodtexCrossMagePaint},underlay last={\wodtexCrossMagePaint}}}
