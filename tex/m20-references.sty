\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{m20-references}[2026/09/30 native linked book navigation]
\RequirePackage[unicode,hidelinks,bookmarksopen,pdfusetitle]{hyperref}
\ifmTwentyEpub\else
 % Native title owns defaults; explicit running-title remains authoritative.
 \let\mTwentyUnsetNativeTitle\@title
 \AddToHook{begindocument/before}{%
  \ifmTwentyRunningTitleExplicit\else
   \ifx\@title\mTwentyUnsetNativeTitle\else\global\let\mTwentyRunningTitle\@title\fi
  \fi}
 \newif\ifmTwentyMainMatterFacingReady
 \newcount\mTwentyMainMatterFacingShipout
 % Main matter begins with its facing verso, before Arabic numbering resets.
 % Reuse this leaf for the next chapter only if no content shipped meanwhile.
 \newcommand\mTwentyBeginMainMatter{%
  \mTwentyBodyEnd\clearpage
  \ifodd\c@page\null\thispagestyle{mTwenty}\newpage\fi
  \mTwentyChapterFacingIllustration
  \global\mTwentyMainMatterFacingReadytrue
  \global\mTwentyMainMatterFacingShipout=\ReadonlyShipoutCounter\relax
  \@mainmattertrue\pagenumbering{arabic}}
 \newcommand\mTwentyCheckMainMatterFacing{%
  \def\mTwentyNeedChapterFacing{1}%
  \ifmTwentyMainMatterFacingReady
   \global\mTwentyMainMatterFacingReadyfalse
   \ifnum\mTwentyMainMatterFacingShipout=\ReadonlyShipoutCounter\relax
    \def\mTwentyNeedChapterFacing{0}%
   \fi
  \fi}
 % book's matter flag must survive the live multicols body group.
 \let\mTwentyNativeFrontmatter\frontmatter
 \let\mTwentyNativeMainmatter\mainmatter
 \let\mTwentyNativeBackmatter\backmatter
 \renewcommand\frontmatter{\mTwentyBodyEnd\global\mTwentyMainMatterFacingReadyfalse\mTwentyNativeFrontmatter\mTwentyBodyBegin}
 \renewcommand\mainmatter{\mTwentyBeginMainMatter\mTwentyBodyBegin}
 \renewcommand\backmatter{\mTwentyBodyEnd\global\mTwentyMainMatterFacingReadyfalse\mTwentyNativeBackmatter\mTwentyBodyBegin}
 \let\mTwentyNativeContents\tableofcontents
 \renewcommand\tableofcontents{\mTwentyBodyEnd\mTwentyNativeContents\mTwentyBodyBegin}
 \AddToHook{env/theindex/before}{\mTwentyBodyEnd}
 \AddToHook{env/theindex/after}{\mTwentyBodyBegin}
 \AddToHook{env/figure/before}{\ifmTwentySidebarActive\PackageError{m20}{M20_E_UNSUPPORTED_NESTING}{Use an inline diagram or art reservation inside a sidebar.}\else\mTwentyBodyEnd\fi}
 \AddToHook{env/figure/after}{\mTwentyBodyBegin}
 \AddToHook{env/table/before}{\ifmTwentySidebarActive\PackageError{m20}{M20_E_UNSUPPORTED_NESTING}{Use m20table inside a sidebar.}\else\mTwentyBodyEnd\fi}
 \AddToHook{env/table/after}{\mTwentyBodyBegin}
 % book's index switches document-level columns; keep one output routine.
 \renewenvironment{theindex}{%
   \mTwentyBodyEnd\chapter*{\indexname}\mTwentyBodyEnd
   \addcontentsline{toc}{chapter}{\indexname}\markboth{\indexname}{\indexname}%
   \parindent\z@\parskip\z@ plus .3bp\relax\let\item\@idxitem
   \begin{multicols}{2}
 }{\end{multicols}\clearpage}
\fi
\endinput
