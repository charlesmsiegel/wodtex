\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{m20-art-image}[2026/10/01 stretched art with optional caption band]
\RequirePackage{expl3}
\providecommand\mTwentyArtImageBottomInset{7bp}
\ExplSyntaxOn
\bool_new:N \l_mtw_art_has_caption_bool
\dim_new:N \l_mtw_art_image_height_dim
\newcommand\mTwentyArtImageContents{
 \bool_set_false:N \l_mtw_art_has_caption_bool
 \tl_if_blank:VF \l_mtw_art_caption_tl {\bool_set_true:N \l_mtw_art_has_caption_bool}
 \tl_if_blank:VF \l_mtw_art_credit_tl {\bool_set_true:N \l_mtw_art_has_caption_bool}
 \dim_set:Nn \l_mtw_art_image_height_dim {\mTwentyArtHeight-7bp-\mTwentyArtImageBottomInset}
 \bool_if:NT \l_mtw_art_has_caption_bool
  {\dim_set:Nn \l_mtw_art_image_height_dim {\mTwentyArtHeight-40bp}}
 % Explicit width and height intentionally distort aspect ratio.
 % Template frame insets remain; a caption band exists only for text.
 \node[inner~sep=0bp,anchor=north~west]
  at (7bp,\dimexpr\mTwentyArtHeight-7bp\relax)
  {\includegraphics[width=\dimexpr\mTwentyArtWidth-14bp\relax,height=\l_mtw_art_image_height_dim]{\mTwentyArtImage}};
 \bool_if:NT \l_mtw_art_has_caption_bool {
  \node[inner~sep=0bp,anchor=south,text~width=\dimexpr\mTwentyArtWidth-14bp\relax,align=center]
   at (.5\mTwentyArtWidth,7bp)
   {\fontsize{8bp}{10bp}\selectfont\mTwentyArtCaption\space\mTwentyArtCredit};
 }
}
\ExplSyntaxOff
\endinput
