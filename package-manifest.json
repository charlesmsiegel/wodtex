{
  "schema_version": 1,
  "name": "wodtex-m20",
  "include": [
    ".gitattributes",
    "install.sh",
    "README.md",
    "requirements.txt",
    "*.cls",
    "runtime.lock.json",
    "package-manifest.json",
    "profiles/*.json",
    "profiles/*.tex",
    "tex/*.sty",
    "tex/*.lua",
    "scripts/*.py",
    "scripts/*.cjs",
    "epub/*",
    "examples/*.tex",
    "examples/*.py",
    "examples/content/*",
    "tests/*.py",
    "docs/*.txt",
    "docs/*.md",
    "docs/design/*",
    "contrib/original-m20-layout/README.md",
    "contrib/original-m20-layout/apply.py",
    "contrib/original-m20-layout/manifest.json",
    "contrib/original-m20-layout/changes.patch",
    "contrib/original-m20-layout/overrides/tex/*.sty",
    "contrib/original-m20-layout/overrides/profiles/*.tex",
    "contrib/original-m20-layout/overrides/scripts/*.py",
    "contrib/original-m20-layout/overrides/tests/*.py",
    "examples/art/*",
    "docs/superpowers/plans/*.md"
    ,"docs/profiles/*.md"
    ,"examples/profiles/*.tex"
    ,"examples/profiles/*.md"
  ],
  "excluded_inputs": [
    "fonts",
    "assets",
    "inputs",
    ".runtime",
    "build",
    "private manuscripts"
  ],
  "license_note": "Original M20 fonts and decorative art are user-supplied licensed inputs. They and built files embedding them are not redistributed in the source archive."
}
