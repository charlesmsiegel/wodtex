 \IfFileExists{\mTwentyAssetPath sidebar-shadow-top-left.reference-template.pdf}{%
  \begin{scope}[overlay]
   \mTwentySidebarShadowTile{bottom-left}{-.94bp}{-9.86bp}{12bp}{12bp}
   \mTwentySidebarShadowTile{bottom-middle}{11.06bp}{-9.86bp}{\dimexpr\mTwentyOuterWidth-12.97bp}{12bp}
   \mTwentySidebarShadowTile{bottom-right}{\dimexpr\mTwentyOuterWidth-1.91bp}{-9.86bp}{12bp}{12bp}
   \mTwentySidebarShadowTile{middle-left}{-.94bp}{2.14bp}{12bp}{\dimexpr\mTwentyFrameHeight-13.2bp}
   \mTwentySidebarShadowTile{middle-middle}{11.06bp}{2.14bp}{\dimexpr\mTwentyOuterWidth-12.97bp}{\dimexpr\mTwentyFrameHeight-13.2bp}
   \mTwentySidebarShadowTile{middle-right}{\dimexpr\mTwentyOuterWidth-1.91bp}{2.14bp}{12bp}{\dimexpr\mTwentyFrameHeight-13.2bp}
   \mTwentySidebarShadowTile{top-left}{-.94bp}{\dimexpr\mTwentyFrameHeight-11.06bp}{12bp}{12bp}
   \mTwentySidebarShadowTile{top-middle}{11.06bp}{\dimexpr\mTwentyFrameHeight-11.06bp}{\dimexpr\mTwentyOuterWidth-12.97bp}{12bp}
   \mTwentySidebarShadowTile{top-right}{\dimexpr\mTwentyOuterWidth-1.91bp}{\dimexpr\mTwentyFrameHeight-11.06bp}{12bp}{12bp}
  \end{scope}
 }{}}
\newcommand\mTwentySidebarTexture{%
 \IfFileExists{\mTwentyAssetPath sidebar-texture.reference-template.pdf}{%
  \begin{scope}[overlay]
   \clip (0,0) rectangle (\mTwentyOuterWidth,\mTwentyFrameHeight);
   \@tempdima=4.714048443\mTwentyFrameHeight
   \ifdim\@tempdima>\mTwentyOuterWidth
    \node[inner sep=0bp,outer sep=0bp] at (.5\mTwentyOuterWidth,.5\mTwentyFrameHeight)
     {\includegraphics[height=\mTwentyFrameHeight]{\mTwentyAssetPath sidebar-texture.reference-template.pdf}};
   \else
    \node[inner sep=0bp,outer sep=0bp] at (.5\mTwentyOuterWidth,.5\mTwentyFrameHeight)
     {\includegraphics[width=\mTwentyOuterWidth]{\mTwentyAssetPath sidebar-texture.reference-template.pdf}};
   \fi
  \end{scope}
 }{%
  \IfFileExists{\mTwentyAssetPath sidebar-background.original-template.pdf}{%
   \begin{scope}[overlay]\clip (0,0) rectangle (\mTwentyOuterWidth,\mTwentyFrameHeight);
    \node[inner sep=0bp,outer sep=0bp] at (.5\mTwentyOuterWidth,.5\mTwentyFrameHeight)
     {\includegraphics[width=\mTwentyOuterWidth]{\mTwentyAssetPath sidebar-background.original-template.pdf}};
   \end{scope}
  }{}}}
\newcommand\mTwentySidebarRules{%
 \begin{scope}[even odd rule]
  \clip
   (0,0) rectangle (\mTwentyOuterWidth,\mTwentyFrameHeight)
   (3.5bp,3.5bp) rectangle (\dimexpr\mTwentyOuterWidth-3.5bp,\dimexpr\mTwentyFrameHeight-3.5bp)
   (5.831bp,5.831bp) rectangle (\dimexpr\mTwentyOuterWidth-5.831bp,\dimexpr\mTwentyFrameHeight-5.831bp)
   (7bp,7bp) rectangle (\dimexpr\mTwentyOuterWidth-7bp,\dimexpr\mTwentyFrameHeight-7bp);
  \shade[shading=mTwentySidebarGold] (0,0) rectangle (\mTwentyOuterWidth,\mTwentyFrameHeight);
 \end{scope}}

\newcommand\mTwentyShipFrame{%
 \ifvoid\mTwentySidebarPageContent\else
 \global\advance\mTwentySidebarPageSegment1
 \setbox\mTwentyFrameContent=\vbox{%
  \hsize=\mTwentyUsableWidth\linewidth=\hsize
  \vskip7.2bp
  {\centering\mTwentyHeadingControls\mTwentyHeadingNarrowFont\mdseries\let\textbf\@firstofone\fontsize{18bp}{18bp}\selectfont\color{m20gold}\mTwentySidebarTitle\ifnum\mTwentySidebarPageSegment>1\space(continued)\fi\par}%
  \vskip5bp
  \unvbox\mTwentySidebarPageContent
  \vskip10bp}
 \global\setbox\mTwentySidebarPageContent=\box\voidb@x
 \mTwentyFrameHeight=\ht\mTwentyFrameContent\advance\mTwentyFrameHeight\dp\mTwentyFrameContent\advance\mTwentyFrameHeight14bp
 \par\addvspace{\mTwentySidebarBeforeGap}\noindent
 \begin{tikzpicture}[baseline=0bp]
  \path[use as bounding box] (0,0) rectangle (\mTwentyOuterWidth,\mTwentyFrameHeight);
  \mTwentySidebarShadow
  \fill[m20purple] (0,0) rectangle (\mTwentyOuterWidth,\mTwentyFrameHeight);
  \mTwentySidebarTexture
  \mTwentySidebarRules
  \node[inner sep=0bp,anchor=north west,text=white] (m20content) at (25bp,\dimexpr\mTwentyFrameHeight-7bp) {\box\mTwentyFrameContent};
  \node[inner sep=0bp,anchor=north west] at (0,\mTwentyFrameHeight) {\mTwentyPosition{\mTwentySidebarID}{\mTwentyOuterWidth}{\mTwentyUsableWidth}{\mTwentySidebarFrameColumns}{sidebar}{\number\mTwentySidebarPageSegment}{\mTwentySidebarPlace}{\mTwentyFrameHeight}};
 \end{tikzpicture}\par
 \vskip\mTwentySidebarAfterGap\relax
 \fi
}
\newcommand\mTwentyTypesetText[1]{%
 \setbox\mTwentyGalley=\vbox{%
  \hsize=\mTwentyTextWidth\linewidth=\hsize\columnwidth=\hsize\textwidth=\hsize
  \everypar{}%
  % Color belongs to each shipped frame, not to the split galley. A color
  % stack push in the galley would cross pages and turn later body text white.
  \mTwentySidebarFont\fontsize{10bp}{10bp}\selectfont
  \parindent=0bp\parskip=2.52bp\relax
  % These endpoint penalties become nodes before the galley is split. Native
  % \vsplit honors them; a short region advances at the first legal block.
  % Keep the assignments local, with natural-height (unstretched) frame boxes.
  \clubpenalty=10000\widowpenalty=10000\displaywidowpenalty=10000
  \pretolerance=-1\emergencystretch=24bp\tolerance=3000
  \let\footnote\mTwentyLocalNote
  \let\mTwentyNote\mTwentyLocalNote
  #1\par}
 \csname mTwentyCheckAtomic:\endcsname
 \mTwentyPaginateChunks
}
\newcommand\mTwentySetSplitHeight{%
 \mTwentyRemaining
 \setbox\mTwentySidebarTitleMeasure=\vbox{\hsize=\mTwentyUsableWidth\parindent=0bp\centering\mTwentyHeadingControls\mTwentyHeadingNarrowFont\mdseries\let\textbf\@firstofone\fontsize{18bp}{18bp}\selectfont\mTwentySidebarTitle\ifnum\mTwentySidebarPageSegment>0\space(continued)\fi\par}%
 \mTwentySplitHeight=\mTwentyAvailable\advance\mTwentySplitHeight-\ht\mTwentySidebarTitleMeasure\advance\mTwentySplitHeight-\dp\mTwentySidebarTitleMeasure\advance\mTwentySplitHeight-53bp
 \advance\mTwentySplitHeight-\mTwentySidebarBeforeGap\advance\mTwentySplitHeight-\mTwentySidebarAfterGap
 \ifvoid\mTwentySidebarPageContent\else\advance\mTwentySplitHeight-\ht\mTwentySidebarPageContent\advance\mTwentySplitHeight-\dp\mTwentySidebarPageContent\advance\mTwentySplitHeight-4bp\fi
 \ifnum\mTwentySegment>0\relax\ifvoid\mTwentyTableHeader\else\advance\mTwentySplitHeight-\ht\mTwentyTableHeader\advance\mTwentySplitHeight-\dp\mTwentyTableHeader\advance\mTwentySplitHeight-4bp\fi\fi
}
\newcommand\mTwentyPaginateChunks{%
 \directlua{m20tables.cut_manual(\number\mTwentyGalley,\number\mTwentyPendingGalley)}%
 \mTwentyPaginateGalley
 \ifx\mTwentyManualMode\@empty\else
  \def\mTwentyPageMode{page}%
  \ifx\mTwentyManualMode\mTwentyPageMode\mTwentyShipFrame\clearpage\else\mTwentyAdvance\fi
  \setbox\mTwentyGalley=\box\mTwentyPendingGalley
  \expandafter\mTwentyPaginateChunks
 \fi
}
\newcommand\mTwentyKeepGalleyTogether{%
 % Measure the already-typeset galley only. Writes, labels and notes are not
 % executed twice. A short flow block starts in a fresh region when needed;
 % a block taller than a whole region continues through the native splitter.
 \def\mTwentyHere{here}%
 \ifvoid\mTwentySidebarPageContent
 \ifx\mTwentySidebarPlace\mTwentyHere\else
  \mTwentyFullSplitHeight=\dimexpr\textheight-4bp-\ht\mTwentySidebarTitleMeasure-\dp\mTwentySidebarTitleMeasure-53bp-\mTwentySidebarBeforeGap-\mTwentySidebarAfterGap\relax
  \ifnum\mTwentySegment>0\relax\ifvoid\mTwentyTableHeader\else\advance\mTwentyFullSplitHeight-\ht\mTwentyTableHeader\advance\mTwentyFullSplitHeight-\dp\mTwentyTableHeader\advance\mTwentyFullSplitHeight-4bp\fi\fi
  \mTwentyCurrentCapacity=\mTwentySplitHeight
  \ifnum\mTwentySidebarColumns=2\multiply\mTwentyFullSplitHeight2\multiply\mTwentyCurrentCapacity2\fi
  \@tempdima=\dimexpr\ht\mTwentyGalley+\dp\mTwentyGalley\relax
  \ifdim\@tempdima>\mTwentyCurrentCapacity
   \ifdim\@tempdima>\mTwentyFullSplitHeight\else
    \mTwentyAdvance\mTwentySetSplitHeight
   \fi
  \fi
 \fi
 \fi
}
\newcommand\mTwentyPaginateGalley{%
 \splittopskip=0bp\splitmaxdepth=3bp
 \mTwentyMoreContenttrue
 \ifdim\dimexpr\ht\mTwentyGalley+\dp\mTwentyGalley\relax<.1bp\relax\mTwentyMoreContentfalse\fi
 \@whilesw\ifmTwentyMoreContent\fi{%
  \mTwentySetSplitHeight
  \mTwentyKeepGalleyTogether
  \ifdim\mTwentySplitHeight<12bp
   \ifnum\mTwentySidebarPageSegment=0\relax\ifvoid\mTwentySidebarPageContent\ifnum\mTwentySegment=0\relax\def\mTwentyHere{here}\ifx\mTwentySidebarPlace\mTwentyHere\PackageError{m20}{M20_E_PLACEMENT_UNAVAILABLE}{The required first segment does not fit at this anchor.}\fi\fi\fi\fi
   \mTwentyAdvance\mTwentySetSplitHeight
  \fi
  \@tempcnta=\mTwentySegment\advance\@tempcnta\mTwentySidebarPageSegment\ifvoid\mTwentySidebarPageContent\else\advance\@tempcnta1\fi
  \directlua{m20tables.check_first(\number\mTwentyGalley,\number\mTwentySplitHeight,"\mTwentySidebarPlace",\number\@tempcnta,\number\dimexpr\textheight-84bp\relax)}
  \ifnum\mTwentySidebarColumns=2
   \@tempdima=\ht\mTwentyGalley\advance\@tempdima\dp\mTwentyGalley
   \@tempdimb=2\mTwentySplitHeight
   \ifdim\@tempdima<\@tempdimb
    \mTwentyBalanceFinal
   \fi
  \fi
  \setbox\mTwentyLeft=\vsplit\mTwentyGalley to\mTwentySplitHeight
  \setbox\mTwentyLeft=\vbox{\unvbox\mTwentyLeft}
  \ifnum\mTwentySidebarColumns=2
   \setbox\mTwentyRight=\vsplit\mTwentyGalley to\mTwentySplitHeight
   \setbox\mTwentyRight=\vbox{\unvbox\mTwentyRight}
  \fi
  \advance\mTwentySegment1
  \mTwentyFrame
  \ifvoid\mTwentyGalley\mTwentyMoreContentfalse\else
   \ifdim\ht\mTwentyGalley<.1bp\relax\mTwentyMoreContentfalse\else\mTwentyAdvance\fi
  \fi
 }}
\ExplSyntaxOn
\seq_new:N \l_mtw_blocks_seq
\seq_new:N \l_mtw_table_parts_seq
\tl_new:N \l_mtw_piece_tl
\tl_new:N \l_mtw_sidebar_body_tl
\cs_new_protected:Npn \mTwentyWideBlocks:n #1 {
 \tl_set:Nn \l_mtw_sidebar_body_tl {#1}
 \regex_replace_all:nnN {\c{begin}\cB\{m20table\cE\}} {\c{mTwentyTableStart}} \l_mtw_sidebar_body_tl
 \regex_replace_all:nnN {\c{end}\cB\{m20table\cE\}} {\c{mTwentyTableEnd}} \l_mtw_sidebar_body_tl
 \regex_replace_all:nnN {\c{begin}\cB\{booktable\cE\}} {\c{mTwentyTableStart}} \l_mtw_sidebar_body_tl
 \regex_replace_all:nnN {\c{end}\cB\{booktable\cE\}} {\c{mTwentyTableEnd}} \l_mtw_sidebar_body_tl
 \seq_set_split:NnV \l_mtw_blocks_seq {\mTwentyTableStart} \l_mtw_sidebar_body_tl
 \seq_pop_left:NN \l_mtw_blocks_seq \l_mtw_piece_tl
 \exp_args:NV \mTwentyTypesetText \l_mtw_piece_tl
 \seq_map_inline:Nn \l_mtw_blocks_seq {
   \seq_set_split:Nnn \l_mtw_table_parts_seq {\mTwentyTableEnd} {##1}
   \seq_pop_left:NN \l_mtw_table_parts_seq \l_mtw_piece_tl
   \exp_after:wN \mTwentySpanTableTokens \l_mtw_piece_tl \mTwentyStop
   \seq_pop_left:NN \l_mtw_table_parts_seq \l_mtw_piece_tl
   \exp_args:NV \mTwentyTypesetText \l_mtw_piece_tl
 }
}
\NewDocumentCommand\mTwentySpanTableTokens{O{} m +u{\mTwentyStop}}{%
 \group_begin:
 \def\mTwentyFrameKind{table-segment}
 \mTwentyOriginalColumnWidth=\mTwentyTextWidth
 \def\mTwentySidebarColumns{1}
 \mTwentyTextWidth=\mTwentyUsableWidth
 \mTwentySegment=0
 \mTwentyTypesetText{\mTwentyTablePDF{#1}{#2}{#3}}
 \global\setbox\mTwentyTableHeader=\box\voidb@x
 \group_end:
}
\cs_new_protected:Npn \mTwentyCheckAtomic: {
 \bool_if:NF \l_mtw_breakable_bool {
  \dim_compare:nNnT {\ht\mTwentyGalley+\dp\mTwentyGalley} > {\mTwentySidebarColumns\dimexpr\textheight-70bp\relax} {
   \PackageError{m20}{M20_E_SIDEBAR_TOO_TALL}{An~unbreakable~sidebar~exceeds~the~usable~page.~Enable~breaking~or~shorten~it.}
  }
 }
}
\cs_new_protected:Npn \mTwentyBalanceFinal {
 \bool_if:NT \l_mtw_balance_bool {\mTwentySplitHeight=.5\@tempdima\advance\mTwentySplitHeight6bp}
}
\cs_new_protected:Npn \mTwentyComposeSidebar:n #1 {
 \mTwentyWideBlocks:n {#1}
 \if\relax\detokenize\expandafter{\the\mTwentyNotes}\relax\else
  \mTwentyTypesetText{\the\mTwentyNotes}
 \fi
 \mTwentyShipFrame
}
\cs_new_protected:Npn \mTwentyComposeOrAtomic:n #1 {
 \bool_if:NTF \l_mtw_breakable_bool {\mTwentyComposeSidebar:n {#1}} {
  \setbox\mTwentyAtomicSidebar=\vbox{
   \hsize=\mTwentyOuterWidth
   \renewcommand\mTwentyRemaining{\mTwentyAvailable=\dimexpr\textheight-4bp\relax}
   \renewcommand\mTwentyAdvance{\mTwentyShipFrame\par}
   \mTwentyComposeSidebar:n {#1}
  }
  \dim_compare:nNnT {\ht\mTwentyAtomicSidebar+\dp\mTwentyAtomicSidebar} > {\textheight-4bp} {
   \PackageError{m20}{M20_E_SIDEBAR_TOO_TALL}{The~complete~unbreakable~sidebar~exceeds~one~usable~region.}
  }
  \mTwentyRemaining
  \dim_compare:nNnT {\ht\mTwentyAtomicSidebar+\dp\mTwentyAtomicSidebar} > {\mTwentyAvailable} {
   \str_if_eq:eeTF {\mTwentySidebarPlace}{here}
    {\PackageError{m20}{M20_E_PLACEMENT_UNAVAILABLE}{The~complete~unbreakable~sidebar~does~not~fit~this~anchor.}}
    {\mTwentyAdvance}
  }
  \par\noindent\box\mTwentyAtomicSidebar\par
 }
}
\ExplSyntaxOff
\newcommand\mTwentySidebarPDF[3]{%
 \global\mTwentyNotes={}%
 \global\setbox\mTwentySidebarPageContent=\box\voidb@x
 \global\mTwentySidebarPageSegment=0
 \def\mTwentySidebarTitle{#2}%
 \def\mTwentyNarrowName{narrow}\def\mTwentyKind{#1}%
 \ifx\mTwentyKind\mTwentyNarrowName\mTwentyNarrowtrue\mTwentyOuterWidth=\mTwentyColumnWidth\else\mTwentyNarrowfalse\mTwentyOuterWidth=\textwidth\fi
 \mTwentyUsableWidth=\mTwentyOuterWidth\advance\mTwentyUsableWidth-50bp
 \mTwentyTextWidth=\mTwentyUsableWidth
 \ifnum\mTwentySidebarColumns=2\advance\mTwentyTextWidth-12bp\divide\mTwentyTextWidth2\fi
 \edef\mTwentySidebarFrameColumns{\mTwentySidebarColumns}%
 \let\mTwentySidebarRegionAdvance\mTwentyAdvance
 \let\mTwentyAdvance\mTwentySidebarAdvance
 \mTwentySegment=0
 \mTwentyPlacement
 \csname mTwentyComposeOrAtomic:n\endcsname{#3}%
}
