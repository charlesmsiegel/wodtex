\newcommand\mTwentyAppendNote[2]{\global\mTwentyNotes=\expandafter{\the\mTwentyNotes\par\noindent\textsuperscript{#1}#2}}
\newcommand\mTwentyLocalNote[1]{\stepcounter{m20sidebarnote}\textsuperscript{\arabic{m20sidebarnote}}\begingroup\edef\mTwentyNewNote{\endgroup\noexpand\mTwentyAppendNote{\arabic{m20sidebarnote}}{\unexpanded{#1}}}\mTwentyNewNote}
\newcommand\mTwentyRemaining{%
 \par
 % Settle pending paragraph/page output before reading pagetotal. Otherwise
 % a heading near the old column limit can force a break on the next page.
 \ifmTwentyBodyActive\penalty0\fi
 \ifmTwentyBodyActive
  \mTwentyAvailable=\@colroom
  \@tempdima=\pagetotal
  \@whiledim\@tempdima>\@colroom\do{\advance\@tempdima-\@colroom}
  \advance\mTwentyAvailable-\@tempdima
 \else
  \ifdim\pagegoal=\maxdimen\mTwentyAvailable=\textheight\else
    \mTwentyAvailable=\pagegoal
  \fi
  % A newly started native text page may still have pagegoal=maxdimen while
  % admitted top/bottom floats already reduced colroom. Closing multicols
  % must not restore a full-page budget for the following wide sidebar.
  \ifdim\@colroom<\mTwentyAvailable\mTwentyAvailable=\@colroom\fi
  \advance\mTwentyAvailable-\pagetotal
 \fi
 \advance\mTwentyAvailable-4bp
}
\newcommand\mTwentyAdvance{\ifmTwentyNarrow\ifmTwentyBodyActive\columnbreak\else\newpage\fi\else\newpage\fi}
\newcommand\mTwentySidebarAdvance{%
 \ifvoid\mTwentySidebarPageContent
  \mTwentySidebarRegionAdvance
 \else
  % A continuation of this sidebar always starts on another physical page.
  \mTwentyShipFrame\clearpage
 \fi}
\newcommand\mTwentyPlacement{%
 \def\mTwentyNextPage{next-page}\def\mTwentyHere{here}%
 \ifx\mTwentySidebarPlace\mTwentyNextPage
  \clearpage
 \fi
 \mTwentyRemaining
 \ifdim\mTwentyAvailable<70bp
  \ifx\mTwentySidebarPlace\mTwentyHere
   \PackageError{m20}{M20_E_PLACEMENT_UNAVAILABLE: \mTwentySidebarID}{Required first segment needs at least 70bp at this exact anchor. Choose another anchor or next-page.}%
  \else\mTwentyAdvance\mTwentyRemaining\fi
 \fi}
\newcommand\mTwentyFrame{%
 % Text columns and spanning tables are natural-height bands in one page
 % frame. Global storage survives the contained-table formatting group.
 \global\setbox\mTwentySidebarPageContent=\vbox{%
  \hsize=\mTwentyUsableWidth\linewidth=\hsize
  \ifvoid\mTwentySidebarPageContent\else\unvbox\mTwentySidebarPageContent\vskip4bp\fi
  \ifnum\mTwentySegment>1\relax\ifvoid\mTwentyTableHeader\else\copy\mTwentyTableHeader\vskip4bp\fi\fi
  \nointerlineskip\hbox{\box\mTwentyLeft\ifnum\mTwentySidebarColumns=2\hskip12bp\box\mTwentyRight\fi}}%
}

% Authentic page-6 sidebar paint. The complete border still occupies 7bp,
% so galley widths, frame heights and legal fragment endpoints stay unchanged.
% PGF maps 25..75 of a declared vertical shading onto the painted rectangle.
\begingroup\selectcolormodel{cmyk}
\pgfdeclareverticalshading{mTwentySidebarGold}{100bp}{%
 cmyk(0bp)=(.2888,.4368,.8328,.0635);
 cmyk(25bp)=(.2888,.4368,.8328,.0635);
 cmyk(25.5525bp)=(.2888,.4368,.8328,.0635);
 cmyk(75bp)=(.09,.06,.55,0);
 cmyk(100bp)=(.09,.06,.55,0)}
\endgroup
\newcommand\mTwentySidebarShadowTile[5]{%
 \node[inner sep=0bp,outer sep=0bp,anchor=south west] at (#2,#3)
  {\includegraphics[width=#4,height=#5]{\mTwentyAssetPath sidebar-shadow-#1.reference-template.pdf}};}
