\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{m20-core}[2026/09/30 shared M20 manuscript semantics]
\RequirePackage{expl3,xparse,amsmath,graphicx,makeidx}
\newcounter{m20sidebar}
\newcounter{m20sidebarnote}
\newcounter{m20table}
\newif\ifmTwentySidebarActive
\def\mTwentyProfile{m20}
\providecommand\mTwentyBuildAssetPath{assets/}
\providecommand\mTwentyBuildFontPath{fonts/}
\let\mTwentyAssetPath\mTwentyBuildAssetPath
\let\mTwentyFontPath\mTwentyBuildFontPath
\def\mTwentyRunningTitle{}
\newif\ifmTwentyRunningTitleExplicit

% Credit metadata belongs in the document header; no person is inferred.
\def\mTwentyWrittenByText{}
\def\mTwentyDevelopedByText{}
\def\mTwentyEditedByText{}
\def\mTwentySpecialThanksText{}
\def\mTwentyCopyrightYearText{\number\year}
\NewDocumentCommand\mTwentyCopyrightYear{m}{\gdef\mTwentyCopyrightYearText{#1}}
\let\mTwentyPubliccopyrightyear\mTwentyCopyrightYear
\NewDocumentCommand\mTwentyWrittenBy{m}{\gdef\mTwentyWrittenByText{#1}}
\NewDocumentCommand\mTwentyDevelopedBy{m}{\gdef\mTwentyDevelopedByText{#1}}
\NewDocumentCommand\mTwentyEditedBy{m}{\gdef\mTwentyEditedByText{#1}}
\NewDocumentCommand\mTwentySpecialThanks{m}{\gdef\mTwentySpecialThanksText{#1}}
\let\mTwentyPublicwrittenby\mTwentyWrittenBy
\let\mTwentyPublicdevelopedby\mTwentyDevelopedBy
\let\mTwentyPubliceditedby\mTwentyEditedBy
\let\mTwentyPublicspecialthanks\mTwentySpecialThanks
\def\mTwentyMath{legacy}
\def\mTwentyChapterTitleSize{60bp}
\def\mTwentyChapterTitleLeading{54bp}
\def\mTwentyChapterBodyGap{6bp}
\providecommand\mTwentyBodyBegin{}
\providecommand\mTwentyBodyEnd{}
\providecommand\mTwentyNewPage{\clearpage}
\providecommand\mTwentyAnchor[1]{}
\ExplSyntaxOn
\prop_new:N \g_mtw_ids_prop
\cs_new_protected:Npn \mTwentyRegisterID:n #1 {
 \regex_match:nnF {\A[A-Za-z][-A-Za-z0-9:._]*\Z}{#1}{\PackageError{m20}{M20_E_INVALID_ID}{Use~a~nonempty~stable~XML-safe~ID.}}
 \prop_if_in:NnT \g_mtw_ids_prop {#1}{\PackageError{m20}{M20_E_DUPLICATE_ID:~#1}{Semantic~IDs~must~be~unique.}}
 \prop_gput:Nnn \g_mtw_ids_prop {#1}{used}
}
\keys_define:nn {m20/setup} {
 profile .code:n = \def\mTwentyProfile{#1},
 asset-path .code:n = \def\mTwentyAssetPath{#1},
 font-path .code:n = \def\mTwentyFontPath{#1},
 running-title .code:n = \def\mTwentyRunningTitle{#1}\mTwentyRunningTitleExplicittrue,
 math .choice:,
 math / legacy .code:n = \def\mTwentyMath{legacy},
 math / unicode .code:n = \def\mTwentyMath{unicode},
 chapter-title-size .code:n = \gdef\mTwentyChapterTitleSize{#1},
 chapter-title-leading .code:n = \gdef\mTwentyChapterTitleLeading{#1},
 chapter-body-gap .code:n = \gdef\mTwentyChapterBodyGap{#1},
 unknown .code:n = \PackageError{m20}{M20_E_UNKNOWN_SETUP:~\l_keys_key_str}{Unknown~setup~key}
}
\NewDocumentCommand\mTwentySetup{m}{\keys_set:nn {m20/setup}{#1}}
\NewDocumentCommand\mTwentyDiagramAlt{m}{}
\cs_new_protected:cpn {mTwentyPublicdiagramalt}{\mTwentyDiagramAlt}
\tl_new:N \l_mtw_id_tl
\tl_new:N \l_mtw_place_tl
\int_new:N \l_mtw_columns_int
\bool_new:N \l_mtw_breakable_bool
\bool_new:N \l_mtw_balance_bool
\keys_define:nn {m20/sidebar} {
 id .tl_set:N = \l_mtw_id_tl,
 place .choice:,
 place / flow .code:n = \tl_set:Nn \l_mtw_place_tl {flow},
 place / here .code:n = \tl_set:Nn \l_mtw_place_tl {here},
 place / next-page .code:n = \tl_set:Nn \l_mtw_place_tl {next-page},
 columns .int_set:N = \l_mtw_columns_int,
 breakable .bool_set:N = \l_mtw_breakable_bool,
 balance .bool_set:N = \l_mtw_balance_bool,
 unknown .code:n = \PackageError{m20}{M20_E_UNKNOWN_SIDEBAR:~\l_keys_key_str}{Unknown~sidebar~key}
}
\cs_new_protected:Npn \mTwentySidebarSemantic:nnnn #1#2#3#4 {
 \ifmTwentySidebarActive\PackageError{m20}{M20_E_UNSUPPORTED_NESTING}{A~breakable~sidebar~cannot~be~nested~inside~another~sidebar.}\fi
 \group_begin:
 \stepcounter{m20sidebar}
 \setcounter{m20sidebarnote}{0}
 \mTwentySidebarActivetrue
 \tl_set:Nx \l_mtw_id_tl {sidebar-\arabic{m20sidebar}}
 \tl_set:Nn \l_mtw_place_tl {flow}
 \int_set:Nn \l_mtw_columns_int {1}
 \bool_set_true:N \l_mtw_breakable_bool
 \bool_set_true:N \l_mtw_balance_bool
 \keys_set:nn {m20/sidebar}{#2}
 \int_compare:nNnTF {\l_mtw_columns_int} > {2}
  {\PackageError{m20}{M20_E_INVALID_COLUMNS}{Only~one~or~two~sidebar~columns~are~supported}}{}
 \int_compare:nNnTF {\l_mtw_columns_int} < {1}
  {\PackageError{m20}{M20_E_INVALID_COLUMNS}{Only~one~or~two~sidebar~columns~are~supported}}{}
 \str_if_eq:nnT {#1}{narrow} {
  \int_compare:nNnF {\l_mtw_columns_int} = {1}
   {\PackageError{m20}{M20_E_NARROW_TWO_COLUMNS}{A~narrow~sidebar~has~one~text~column}}
 }
 \edef\mTwentySidebarID{\tl_use:N \l_mtw_id_tl}
 \exp_args:NV \mTwentyRegisterID:n \l_mtw_id_tl
 \edef\mTwentySidebarPlace{\tl_use:N \l_mtw_place_tl}
 \edef\mTwentySidebarColumns{\int_use:N \l_mtw_columns_int}
 \bool_if:NTF \l_mtw_breakable_bool {\def\mTwentySidebarBreakable{true}}{\def\mTwentySidebarBreakable{false}}
 \ifmTwentyEpub
   \mTwentyAsideBegin{\mTwentySidebarID}{#3}#4\mTwentyAsideEnd
 \else
   \mTwentySidebarPDF{#1}{#3}{#4}
 \fi
 \group_end:
}
\NewDocumentEnvironment{m20sidebar}{O{}m+b}{\mTwentySidebarSemantic:nnnn {narrow}{#1}{#2}{#3}}{}
\NewDocumentEnvironment{m20sidebarwide}{O{}m+b}{\mTwentySidebarSemantic:nnnn {wide}{#1}{#2}{#3}}{}
\AddToHook{env/m20sidebarwide/before}{\ifmTwentySidebarActive\PackageError{m20}{M20_E_UNSUPPORTED_NESTING}{A~sidebar~cannot~contain~another~sidebar.}\fi\ifmTwentyEpub\else\mTwentyBodyEnd\fi}
\AddToHook{env/m20sidebarwide/after}{\ifmTwentyEpub\else\mTwentyBodyBegin\fi}
\AddToHook{env/m20sidebar/after}{\ifmTwentyEpub\else\mTwentyBodyBegin\fi}
\NewDocumentEnvironment{m20table}{O{}m+b}{%
 \ifmTwentyEpub\mTwentyTableEpub{#1}{#2}{#3}%
 \else\mTwentyTablePDF{#1}{#2}{#3}\fi
}{}
\AddToHook{env/m20table/before}{\ifmTwentyEpub\else\ifmTwentySidebarActive\else\mTwentyBodyEnd\fi\fi}
\AddToHook{env/m20table/after}{\ifmTwentyEpub\else\ifmTwentySidebarActive\else\mTwentyBodyBegin\fi\fi}
% TeX control words cannot contain digits. This dispatcher makes the public
% literal manuscript spelling \m20setup{...} valid without changing catcodes.
\tl_new:N \l_mtw_command_tl
\cs_new_protected:Npn \m 20 {\tl_clear:N \l_mtw_command_tl \mTwentyScanCommand:}
\cs_new_protected:Npn \mTwentyScanCommand: {
 \peek_catcode:NTF a {\mTwentyTakeCommand:n}
  {\cs_if_exist:cTF {mTwentyPublic\tl_use:N \l_mtw_command_tl}
    {\use:c {mTwentyPublic\tl_use:N \l_mtw_command_tl}}
    {\PackageError{m20}{M20_E_UNKNOWN_COMMAND:~m20\tl_use:N\l_mtw_command_tl}{Check~the~public~command~spelling.}}}
}
\cs_new_protected:Npn \mTwentyTakeCommand:n #1 {
 \tl_put_right:Nn \l_mtw_command_tl {#1}\mTwentyScanCommand:
}
\ExplSyntaxOff
\providecommand\mTwentyAsideBegin[2]{\par\medskip\noindent\textbf{#2}\par}
\providecommand\mTwentyAsideEnd{\par\medskip}
\NewDocumentCommand\mTwentySidebarBreak{O{page}}{%
 \ifmTwentySidebarActive
  \def\mTwentyBreakableTrue{true}\ifx\mTwentySidebarBreakable\mTwentyBreakableTrue\else
   \PackageError{m20}{M20_E_ATOMIC_SIDEBAR_BREAK}{Remove the manual break or choose breakable=true.}\fi
  \def\mTwentyBreakMode{#1}\def\mTwentyPageMode{page}\def\mTwentyColumnMode{column}%
  \ifx\mTwentyBreakMode\mTwentyPageMode\else\ifx\mTwentyBreakMode\mTwentyColumnMode\else
   \PackageError{m20}{M20_E_BREAK_MODE}{Choose page or column.}\fi\fi
  \par\ifmTwentyEpub\else\directlua{m20tables.manual_break("#1")}\fi
 \else\PackageError{m20}{M20_E_BREAK_OUTSIDE_SIDEBAR}{Sidebar breaks are only valid inside sidebars}\fi}
\NewDocumentCommand\mTwentyNote{m}{\footnote{#1}}
\NewDocumentCommand\mTwentyEpubSafe{m}{}

\ExplSyntaxOn
\clist_map_inline:nn {setup,bodybegin,bodyend,newpage,anchor,sidebarbreak,note,epubsafe} {
 \cs_new_protected:cpn {mTwentyPublic#1} {\use:c {mTwenty\str_case:nn {#1} {{setup}{Setup}{bodybegin}{BodyBegin}{bodyend}{BodyEnd}{newpage}{NewPage}{anchor}{Anchor}{sidebarbreak}{SidebarBreak}{note}{Note}{epubsafe}{EpubSafe}}}}
}
\ExplSyntaxOff
