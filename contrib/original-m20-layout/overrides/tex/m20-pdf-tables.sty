\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{m20-pdf-tables}[2026/09/30 ordered fixed-width row blocks]
\RequirePackage{array}
% MiKTeX may update colortbl independently of its older array/kernel bundle.
% Pre-tagging array has the same paragraph-cell insertion under insert@column.
% Keep modern array's tagged implementation whenever it is available.
\ifdefined\insert@pcolumn\else
 \let\insert@pcolumn\insert@column
\fi
\RequirePackage{colortbl}
% The layout's earlier begin-document hook has already opened a multicols
% group when colortbl initializes @tabarray. Keep that initialization after
% the columns close, otherwise nested native tables restore undefined colors.
\AddToHook{begindocument/end}{\global\let\@tabarray\@tabarray}
% The supplied M20 table reference uses Futura, bold headers, no rules and
 % pale-purple alternating body bands. Sidebar tables instead alternate
% gold/white text on their existing dark frame, as in the sidebar reference.
% Exact pale-band pixel from the user-supplied table screenshot. The sidebar
% text continues to use the template's existing CMYK m20gold/m20purple colors.
\definecolor{m20tableband}{RGB}{237,232,241}
\newcommand\mTwentyTableCellStyle{%
 \mTwentySidebarFont\fontsize{10bp}{10bp}\selectfont
 \ifnum\rownum>\mTwentyTableHeadingRows\relax
  \ifmTwentySidebarActive
   \ifodd\numexpr\rownum-\mTwentyTableHeadingRows\relax\color{m20gold}\else\color{white}\fi
  \else\color{black}\fi
 \else
  \bfseries\mTwentyHeadingControls\ifmTwentySidebarActive\color{white}\else\color{black}\fi
 \fi}
\newdimen\mTwentyTableWidth
\newdimen\mTwentyCellWidth
\newdimen\mTwentyTableOffset
\newtoks\mTwentyTableNotes
\newcounter{m20tablenote}
\newcommand\mTwentyAppendTableNote[2]{\global\mTwentyTableNotes=\expandafter{\the\mTwentyTableNotes\par\noindent\textsuperscript{#1}#2}}
\newcommand\mTwentyTableNote[1]{\stepcounter{m20tablenote}\textsuperscript{\alph{m20tablenote}}\begingroup\edef\mTwentyNewNote{\endgroup\noexpand\mTwentyAppendTableNote{\alph{m20tablenote}}{\unexpanded{#1}}}\mTwentyNewNote}
\newbox\mTwentyTableRow
\newbox\mTwentyNativeTable
\newbox\mTwentyRowStream
\newbox\mTwentyRowChunk
\newbox\mTwentyTableHeader
\newbox\mTwentyLocalTableHeader
\newbox\mTwentyTableNotesBox
\newbox\mTwentyTableFloatBox
\newbox\mTwentyTableLeadBox
\newif\ifmTwentyTableLeadActive
% Short full-width alignments are genuine native top/bottom floats. Permit
% several compact tables on a page, and stack float-only pages at their top.
\setcounter{topnumber}{6}
\setcounter{bottomnumber}{6}
\setcounter{totalnumber}{12}
\renewcommand\topfraction{.9}
\renewcommand\bottomfraction{.8}
\renewcommand\textfraction{.08}
\renewcommand\floatpagefraction{.5}
\setlength\floatsep{10bp plus2bp minus2bp}
\setlength\textfloatsep{10bp plus2bp minus2bp}
\setlength\@fptop{0bp}
\setlength\@fpsep{10bp}
\setlength\@fpbot{0bp plus1fil}
% A bounded, render-only association: existing title/lead tokens and their
% table are boxed once and move together. Labels, destinations and anchors
% remain in that box, rather than in an unrelated preceding prose column.
\NewDocumentEnvironment{m20tablelead}{+b}{%
 \begingroup
 \ifmTwentySidebarActive\PackageError{m20}{M20_E_TABLE_LEAD_CONTEXT}{A table lead float must be outside a sidebar.}\fi
 \setbox\mTwentyTableLeadBox=\vbox{%
  \mTwentyTableLeadActivetrue
  \hsize=\textwidth\linewidth=\hsize\parindent=18bp\parskip=3bp
  \rmfamily\fontsize{10bp}{12bp}\selectfont\color{black}%
  \let\mTwentyBodyBegin\relax\let\mTwentyBodyEnd\relax
  \let\mTwentyKeepHeading\@gobble
  \@nobreakfalse\@noskipsecfalse\everypar{}%
  % Table titles retain the profile-selected heading role; column labels
  % independently use the genuine Goudy Old Style bold prose face.
  \def\subsection{\@startsection{subsection}{2}{\z@}{0bp}{3bp}{\centering\mTwentyHeadingControls\mTwentyHeadingFont\mdseries\let\textbf\@firstofone\fontsize{11bp}{13bp}\selectfont\color{m20purple}}}%
  #1\par}%
 \ifdim\dimexpr\ht\mTwentyTableLeadBox+\dp\mTwentyTableLeadBox\relax>\dimexpr\textheight-60bp\relax
  \PackageError{m20}{M20_E_TABLE_LEAD_TOO_TALL}{The bounded title/lead/table group must fit one page. Leave multipage tables in owner pagination.}%
 \fi
 \begin{table*}[tb]\noindent\box\mTwentyTableLeadBox\par\end{table*}%
 \endgroup
}{}
% Table-lead floats stay inside the live body columns. Closing and restarting
% them merely to enqueue a float creates ambiguous stacked reading bands.
\AddToHook{env/m20tablelead/after}{\mTwentyBodyBegin}
\newif\ifmTwentyTableActive
\newdimen\mTwentyOriginalColumnWidth
\directlua{m20tables = dofile(kpse.find_file("tex/m20-table-nodes.lua", "tex"))}
\newcount\mTwentyTableColumns
\newcount\mTwentyTableRules
\newcount\mTwentyTableDoubleRules
\newif\ifmTwentyPreviousRule
\newcommand\mTwentyTableSplitHeight{%
 \mTwentyRemaining\mTwentySplitHeight=\mTwentyAvailable
 \ifnum\mTwentySegment>0\advance\mTwentySplitHeight-\ht\mTwentyTableHeader\advance\mTwentySplitHeight-\dp\mTwentyTableHeader\fi
}
\newcommand\mTwentyTablePassage{%
 \let\mTwentySetSplitHeight\mTwentyTableSplitHeight
 \def\mTwentyAdvance{\newpage}%
 \setbox\mTwentyGalley=\box\mTwentyRowStream
 \mTwentySegment=0\splittopskip=0bp\splitmaxdepth=3bp
 \mTwentyMoreContenttrue
 \@whilesw\ifmTwentyMoreContent\fi{%
  \mTwentyTableSplitHeight
  \ifdim\mTwentySplitHeight<12bp\newpage\mTwentyTableSplitHeight\fi
  \directlua{m20tables.check_first(\number\mTwentyGalley,\number\mTwentySplitHeight,"flow",\number\mTwentySegment,\number\textheight)}%
  \ifnum\mTwentySegment>0\copy\mTwentyTableHeader\fi
  \setbox\mTwentyRowChunk=\vsplit\mTwentyGalley to\mTwentySplitHeight
  \unvbox\mTwentyRowChunk
  \advance\mTwentySegment1
  \ifvoid\mTwentyGalley\mTwentyMoreContentfalse\else\newpage\fi
 }
 \global\setbox\mTwentyTableHeader=\box\voidb@x
}
\ExplSyntaxOn
\tl_new:N \l_mtw_table_width_tl
\tl_new:N \l_mtw_table_align_tl
\tl_new:N \l_mtw_table_id_tl
\fp_new:N \l_mtw_table_scale_fp
\int_new:N \l_mtw_table_head_int
\bool_new:N \l_mtw_table_float_bool
\seq_new:N \l_mtw_rows_seq
\seq_new:N \l_mtw_columns_seq
\tl_new:N \l_mtw_column_spec_tl
\keys_define:nn {m20/table} {
 id .tl_set:N = \l_mtw_table_id_tl,
 width .tl_set:N = \l_mtw_table_width_tl,
 scale .fp_set:N = \l_mtw_table_scale_fp,
 align .choices:nn = {left,center,right}{\tl_set:Nx \l_mtw_table_align_tl{\l_keys_choice_tl}},
 head-rows .int_set:N = \l_mtw_table_head_int,
 epub .choices:nn = {table,records}{},
 unknown .code:n = \PackageError{m20}{M20_E_UNKNOWN_TABLE:~\l_keys_key_str}{Unknown~table~key}
}
\cs_new_protected:Npn \mTwentyTablePDF #1#2#3 {
 \group_begin:
 \stepcounter{m20table}
 \tl_set:Nn \l_mtw_table_width_tl {container}
 \tl_set:Nn \l_mtw_table_align_tl {center}
 \tl_set:Nx \l_mtw_table_id_tl {table-\arabic{m20table}}
 \fp_set:Nn \l_mtw_table_scale_fp {1}
 \int_zero:N \l_mtw_table_head_int
 \keys_set:nn {m20/table}{#1}
 \exp_args:NV \mTwentyRegisterID:n \l_mtw_table_id_tl
 \int_compare:nNnT {\l_mtw_table_head_int} < {0}{\PackageError{m20}{M20_E_TABLE_HEADERS}{head-rows~cannot~be~negative}}
 \fp_compare:nNnT {\l_mtw_table_scale_fp} > {1}{\PackageError{m20}{M20_E_TABLE_SCALE}{Scale~must~be~in~0..1}}
 \fp_compare:nNnF {\l_mtw_table_scale_fp} > {0}{\PackageError{m20}{M20_E_TABLE_SCALE}{Scale~must~be~in~0..1}}
 % Four-point horizontal cell inset is the original IDML table default.
 \tabcolsep=4bp
 \str_case:VnF \l_mtw_table_width_tl {
  {container}{\ifmTwentySidebarActive\mTwentyTableWidth=\mTwentyUsableWidth\else\mTwentyTableWidth=\linewidth\fi}
  {column}{\ifmTwentySidebarActive\mTwentyTableWidth=\mTwentyOriginalColumnWidth\else\mTwentyTableWidth=\mTwentyColumnWidth\fi}
 }{\mTwentyTableWidth=\l_mtw_table_width_tl\relax}
 \mTwentyTableWidth=\fp_to_decimal:N \l_mtw_table_scale_fp\mTwentyTableWidth
 \ifdim\mTwentyTableWidth>\linewidth\PackageError{m20}{M20_E_TABLE_TOO_WIDE}{Choose~a~width~within~the~owner's~usable~region.}\fi
 \ifdim\mTwentyTableWidth<1bp\PackageError{m20}{M20_E_TABLE_WIDTH}{Choose~a~positive~usable~table~width.}\fi
 \mTwentyTableColumns=0
 \tl_map_inline:nn {#2} {\str_case:nn {##1} {{l}{\advance\mTwentyTableColumns1}{c}{\advance\mTwentyTableColumns1}{r}{\advance\mTwentyTableColumns1}{p}{\advance\mTwentyTableColumns1}}}
 \ifnum\mTwentyTableColumns<1 \PackageError{m20}{M20_E_TABLE_COLUMN_SPEC}{Use~native~l/c/r/p~column~specification}\fi
 \mTwentyTableRules=0
 \mTwentyTableDoubleRules=0\mTwentyPreviousRulefalse
 \tl_map_inline:nn {#2}{\str_if_eq:nnTF {##1}{|}{\advance\mTwentyTableRules1\ifmTwentyPreviousRule\advance\mTwentyTableDoubleRules1\fi\mTwentyPreviousRuletrue}{\mTwentyPreviousRulefalse}}
 \mTwentyCellWidth=\mTwentyTableWidth\advance\mTwentyCellWidth-\mTwentyTableRules\arrayrulewidth\advance\mTwentyCellWidth-\mTwentyTableDoubleRules\doublerulesep\divide\mTwentyCellWidth\mTwentyTableColumns
 \advance\mTwentyCellWidth-2\tabcolsep

 \ifmTwentyTableActive
  \PackageError{m20}{M20_E_UNSUPPORTED_NESTING}{A multipage table cannot be nested inside another table. Use an atomic native tabular inside its cell.}
 \fi
 \mTwentyTableActivetrue
 \setcounter{m20tablenote}{0}
 \global\mTwentyTableNotes={}
 \let\footnote\mTwentyTableNote
 \let\mTwentyNote\mTwentyTableNote
 \mTwentyTableOffset=0bp
 \str_case:Vn \l_mtw_table_align_tl {{center}{\mTwentyTableOffset=\dimexpr\linewidth-\mTwentyTableWidth\relax\divide\mTwentyTableOffset2}{right}{\mTwentyTableOffset=\dimexpr\linewidth-\mTwentyTableWidth\relax}}

 \tl_set:Nn \l_mtw_column_spec_tl {#2}
 % The converted manuscript's empty edge directives remove cell padding and
 % make shaded panels overhang the body. Retain the native column widths but
 % restore the four-point inset on the two outer edges.
 \regex_replace_once:nnN {\A@\{\}} {} \l_mtw_column_spec_tl
 \regex_replace_once:nnN {@\{\}\Z} {} \l_mtw_column_spec_tl
 \regex_match:nnT {\A[lcr|\s]+\Z}{#2} {
  \tl_clear:N \l_mtw_column_spec_tl
  \tl_map_inline:nn {#2}{\str_case:nn {##1}{
   {l}{\tl_put_right:Nn \l_mtw_column_spec_tl {>{\raggedright\arraybackslash}p{\mTwentyCellWidth}}}
   {c}{\tl_put_right:Nn \l_mtw_column_spec_tl {>{\centering\arraybackslash}p{\mTwentyCellWidth}}}
   {r}{\tl_put_right:Nn \l_mtw_column_spec_tl {>{\raggedleft\arraybackslash}p{\mTwentyCellWidth}}}
   {|}{\tl_put_right:Nn \l_mtw_column_spec_tl {|}}
  }}
 }
 \edef\mTwentyTableHeadingRows{\int_use:N\l_mtw_table_head_int}
 \mTwentySidebarFont\fontsize{10bp}{10bp}\selectfont
 % Compact symmetric row breathing room matches the supplied visual target.
 \setbox\strutbox=\hbox{\vrule width0bp height\dimexpr\ht\strutbox+2bp\relax depth\dimexpr\dp\strutbox+2bp\relax}
 \let\mTwentyTableOriginalStartPbox\@startpbox
 % Start the cell paragraph before its color declaration. A leading vertical
 % color whatsit changes a vtop's reference point and adds a spurious strut.
 \def\@startpbox##1{\mTwentyTableOriginalStartPbox{##1}\leavevmode\mTwentyTableCellStyle}
 \ifmTwentySidebarActive
  \rowcolors{1}{}{}
 \else
  \int_if_odd:nTF {\l_mtw_table_head_int}
   {\rowcolors{\int_eval:n{\l_mtw_table_head_int+1}}{white}{m20tableband}}
   {\rowcolors{\int_eval:n{\l_mtw_table_head_int+1}}{m20tableband}{white}}
 \fi
 \setbox\mTwentyNativeTable=\hbox{\exp_args:NnV \begin{tabular}\l_mtw_column_spec_tl #3\end{tabular}}
 \ifdim\wd\mTwentyNativeTable>\dimexpr\mTwentyTableWidth+.5bp\relax
  \PackageError{m20}{M20_E_TABLE_TOO_WIDE}{Explicit~native~columns~exceed~the~chosen~width.~Reduce~their~dimensions~or~use~l/c/r~columns.}\fi
 % Explicit native widths take precedence within the selected maximum. Record
 % and align the actual box rather than pretending it fills that maximum.
 \mTwentyTableWidth=\wd\mTwentyNativeTable
 \mTwentyTableOffset=0bp
 \str_case:Vn \l_mtw_table_align_tl {{center}{\mTwentyTableOffset=\dimexpr\linewidth-\mTwentyTableWidth\relax\divide\mTwentyTableOffset2}{right}{\mTwentyTableOffset=\dimexpr\linewidth-\mTwentyTableWidth\relax}}
 \directlua{m20tables.extract(\number\mTwentyNativeTable,\number\mTwentyRowStream,\number\mTwentyLocalTableHeader,\int_use:N\l_mtw_table_head_int,\number\dimexpr\textheight-90bp\relax,\number\mTwentyTableOffset)}
 \global\setbox\mTwentyTableHeader=\box\mTwentyLocalTableHeader
 % Notes are typeset exactly once. Copies in an unused candidate float remain
 % unshipped; the owner stream ships the original notes when the table is long.
 \setbox\mTwentyTableNotesBox=\vbox{\hsize=\linewidth\the\mTwentyTableNotes\par}
 \bool_set_false:N \l_mtw_table_float_bool
 \ifmTwentySidebarActive\else\ifmTwentyTableLeadActive\else
  \ifdim\mTwentyTableWidth>\dimexpr\textwidth-1bp\relax
   \setbox\mTwentyTableFloatBox=\vbox{\hsize=\linewidth\parskip=0bp
    \noindent\hspace*{\mTwentyTableOffset}
    \mTwentyPosition{\tl_use:N \l_mtw_table_id_tl}{\mTwentyTableWidth}{\mTwentyTableWidth}{1}{table}{0}{float}{}
    \copy\mTwentyNativeTable\par
    \ifdim\dimexpr\ht\mTwentyTableNotesBox+\dp\mTwentyTableNotesBox\relax>0bp
     \vskip4bp\copy\mTwentyTableNotesBox
    \fi}
   \ifdim\dimexpr\ht\mTwentyTableFloatBox+\dp\mTwentyTableFloatBox\relax<\dimexpr\textheight-60bp\relax
    % The enclosing m20table owns the body-column restart. The native
    % table's after hook must not open multicols inside that environment.
    \begingroup\let\mTwentyBodyBegin\relax
    \begin{table}[tbp]\noindent\box\mTwentyTableFloatBox\par\end{table}
    \endgroup
    \bool_set_true:N \l_mtw_table_float_bool
    \global\setbox\mTwentyTableHeader=\box\voidb@x
   \fi
  \fi
 \fi\fi
 \bool_if:NF \l_mtw_table_float_bool {
  % Multipage alignments keep owner pagination with repeated page-top headers.
  % Sidebar tables remain within their existing ordered frame stream.
  \def\mTwentyTablePlacement{flow}
  \ifmTwentyTableLeadActive\def\mTwentyTablePlacement{float}\else\ifmTwentySidebarActive\else
   \ifdim\mTwentyTableWidth>\dimexpr\textwidth-1bp\relax
    \def\mTwentyTablePlacement{top}
    \par\ifdim\pagetotal>0bp\newpage\fi
   \fi
  \fi\fi
  \par\noindent\hspace*{\mTwentyTableOffset}
  \mTwentyPosition{\tl_use:N \l_mtw_table_id_tl}{\mTwentyTableWidth}{\mTwentyTableWidth}{1}{table}{0}{\mTwentyTablePlacement}{}
  \par\ifmTwentyTableLeadActive
   \unvbox\mTwentyRowStream\global\setbox\mTwentyTableHeader=\box\voidb@x
  \else\ifmTwentySidebarActive\unvbox\mTwentyRowStream\else\mTwentyTablePassage\fi\fi
  \par\unvbox\mTwentyTableNotesBox\par
 }
 \group_end:
}
