\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{m20-pdf-layout}[2026/09/30 isolated live body regions]
\RequirePackage{fontspec,geometry,multicol,xcolor,tikz}
\IfFileExists{microtype.sty}{\RequirePackage[protrusion=true,expansion=true]{microtype}}{}
\InputIfFileExists{profiles/m20.tex}{}{%
 \def\mTwentyPageWidth{612bp}\def\mTwentyPageHeight{792bp}%
 \def\mTwentyBodyWidth{490.4496bp}\def\mTwentyBodyHeight{657bp}%
 \def\mTwentyTop{63bp}\def\mTwentyInner{54bp}\def\mTwentyOuter{67.5504bp}%
 \def\mTwentyColumnWidth{239.2248bp}\def\mTwentyGutter{12bp}}
\geometry{paperwidth=\mTwentyPageWidth,paperheight=\mTwentyPageHeight,inner=\mTwentyInner,outer=\mTwentyOuter,top=\mTwentyTop,textheight=\mTwentyBodyHeight,headheight=0bp,headsep=0bp,footskip=16.81bp}
\setlength\columnsep{\mTwentyGutter}
\setlength\parindent{18bp}
\setlength\parskip{1.44bp plus .2bp minus .4bp}
\setlength\multicolsep{0bp}
\setlength\premulticols{48bp}
\setlength\postmulticols{0bp}
\newif\ifmTwentyBodyActive
\newif\ifmTwentyBlankPage
\newif\ifmTwentyOpenerPage
\newif\ifmTwentyInteriorTitlePage
\newif\ifmTwentyHadChapter
\newcount\mTwentyChapterArtCount
\def\mTwentyChapterRunningTitle{}
\newif\ifmTwentyArtReverse
% Strong endpoint protection is reapplied after each body region and heading.
\newcommand\mTwentyParagraphControls{%
 \clubpenalty=10000\widowpenalty=10000\displaywidowpenalty=10000\@clubpenalty=10000%
 \hyphenpenalty=650\exhyphenpenalty=300\doublehyphendemerits=50000\finalhyphendemerits=10000%
 \tolerance=1200\emergencystretch=1.25em}
\newcommand\mTwentyHeadingControls{\hyphenpenalty=10000\exhyphenpenalty=10000}
\renewcommand\mTwentyBodyBegin{\color{black}\ifmTwentyBodyActive\else\par\ifdim\pagetotal>\dimexpr\textheight-24bp\relax\newpage\fi\global\mTwentyBodyActivetrue\begin{multicols}{2}\mTwentyParagraphControls\raggedcolumns\fi}
\renewcommand\mTwentyBodyEnd{\ifmTwentyBodyActive\par\end{multicols}\global\mTwentyBodyActivefalse\fi\@nobreakfalse\@noskipsecfalse\everypar{}}
\newcommand\mTwentySuspendEnvironment[1]{\ifmTwentyBodyActive\endgroup\mTwentyBodyEnd\begingroup\def\@currenvir{#1}\fi}
\renewcommand\mTwentyNewPage{\mTwentyBodyEnd\clearpage\mTwentyBodyBegin}
\newwrite\mTwentyPositionStream
\AtBeginDocument{\mTwentyLoadFonts\fontsize{10bp}{12bp}\selectfont\mTwentyParagraphControls\raggedbottom\immediate\openout\mTwentyPositionStream=\jobname.m20pos\relax\mTwentyBodyBegin}
\AtEndDocument{\mTwentyBodyEnd\clearpage\immediate\closeout\mTwentyPositionStream}
% Values are frozen now; page and position primitives are evaluated at shipout.
\newcommand\mTwentyPosition[8]{%
 \savepos
 \begingroup
 \edef\mTwentyWrite{\write\mTwentyPositionStream{#1|\noexpand\the\noexpand\ReadonlyShipoutCounter|\noexpand\the\noexpand\lastxpos|\noexpand\the\noexpand\lastypos|\number\dimexpr#2\relax|\number\dimexpr#3\relax|#4|#5|#6|#7|\number\dimexpr#8+0bp\relax|\noexpand\thepage|\noexpand\number\noexpand\c@page}}%
 \mTwentyWrite\endgroup}
\renewcommand\mTwentyAnchor[1]{\mTwentyPosition{#1}{\linewidth}{\linewidth}{1}{anchor}{0}{flow}{}}
\renewcommand\@seccntformat[1]{}
\renewcommand\@startsection[6]{\if@noskipsec\leavevmode\fi\par\@tempskipa #4\relax\@afterindenttrue\ifdim\@tempskipa<\z@\@tempskipa-\@tempskipa\@afterindentfalse\fi\if@nobreak\everypar{}\else\addpenalty\@secpenalty\addvspace\@tempskipa\fi\@ifstar{\@ssect{#3}{#4}{#5}{#6}}{\@dblarg{\@sect{#1}{#2}{#3}{#4}{#5}{#6}}}}
\renewcommand\section{\@startsection{section}{1}{\z@}{7.2bp}{2.1528bp}{\centering\mTwentyHeadingControls\mTwentyHeadingFont\fontsize{24bp}{25bp}\selectfont}}
% Wrap the styled native section only after defining its style.
\let\mTwentyStyledSection\section
\RenewDocumentCommand\section{s o m}{\mTwentyBodyEnd\mTwentyRemaining\ifdim\mTwentyAvailable<108bp\relax\newpage\fi\addvspace{13.5bp}\noindent\mTwentyPosition{span-heading}{\textwidth}{\textwidth}{2}{heading}{0}{flow}{}\IfBooleanTF{#1}{\mTwentyStyledSection*{#3}}{\IfNoValueTF{#2}{\mTwentyStyledSection{#3}}{\mTwentyStyledSection[#2]{#3}}}\vspace{1.8bp}\hrule height1.25bp\vspace{13.5bp}\mTwentyBodyBegin\@afterindentfalse\@afterheading}
\newcommand\mTwentyKeepHeading[1]{\mTwentyRemaining\ifdim\mTwentyAvailable<#1\relax\ifmTwentyBodyActive\columnbreak\else\newpage\fi\fi}
\renewcommand\subsection{\mTwentyKeepHeading{54bp}\@startsection{subsection}{2}{\z@}{7.2bp}{0.01bp}{\raggedright\mTwentyHeadingControls\mTwentyHeadingNarrowFont\fontsize{18bp}{18bp}\selectfont}}
\renewcommand\subsubsection{\mTwentyKeepHeading{42bp}\@startsection{subsubsection}{3}{\z@}{7.2bp}{0.01bp}{\raggedright\mTwentyHeadingControls\mTwentyHeadingFont\fontsize{12bp}{14bp}\selectfont}}
\newif\ifmTwentyNumberedOpener
\let\mTwentyOriginalChapter\chapter
\RenewDocumentCommand\chapter{s o m}{%
 \mTwentyBodyEnd\clearpage
 % Front Contents follows the original credits verso; actual chapters face blanks.
 \def\mTwentyFrontOpening{0}%
 \IfBooleanT{#1}{\if@mainmatter\else\def\mTwentyFrontOpening{1}\fi}%
 \ifnum\mTwentyFrontOpening=1
  \ifodd\c@page\else\mTwentyBlankPagetrue\null\thispagestyle{empty}\newpage\fi
 \else
  \ifodd\c@page\mTwentyBlankPagetrue\null\thispagestyle{empty}\newpage\fi
  \mTwentyBlankPagetrue\null\thispagestyle{empty}\newpage
 \fi
 \IfBooleanTF{#1}{\gdef\mTwentyChapterRunningTitle{#3}}{\IfNoValueTF{#2}{\gdef\mTwentyChapterRunningTitle{#3}}{\gdef\mTwentyChapterRunningTitle{#2}}}
 \global\mTwentyHadChaptertrue
 \IfBooleanTF{#1}{\mTwentyNumberedOpenerfalse\mTwentyOriginalChapter*{#3}}{\mTwentyNumberedOpenertrue\IfNoValueTF{#2}{\mTwentyOriginalChapter{#3}}{\mTwentyOriginalChapter[#2]{#3}}}%
 \mTwentyBodyBegin\@afterindentfalse\@afterheading}
\newbox\mTwentyChapterTitleBox
\newdimen\mTwentyTitleHalfHeight
\newdimen\mTwentyTitleTextWidth
\newcommand\mTwentyMakeOpenerTitle[3]{%
 \setbox\mTwentyChapterTitleBox=\vbox{\hsize=\mTwentyTitleTextWidth\parindent\z@\centering\mTwentyHeadingFont\fontsize{#1}{#2}\selectfont\hyphenpenalty=10000\exhyphenpenalty=10000
  \begingroup\color{m20gold}\ifmTwentyNumberedOpener\if@mainmatter\ifnum\c@secnumdepth>\m@ne\@chapapp\space\thechapter:\par\fi\fi\fi #3\par\endgroup}%
 \mTwentyTitleHalfHeight=\ht\mTwentyChapterTitleBox\advance\mTwentyTitleHalfHeight\dp\mTwentyChapterTitleBox\divide\mTwentyTitleHalfHeight2
}
\def\@makechapterhead#1{%
 \global\mTwentyOpenerPagetrue
 \mTwentyTitleTextWidth=\dimexpr\textwidth-40bp\relax
 \mTwentyMakeOpenerTitle{\mTwentyChapterTitleSize}{\mTwentyChapterTitleLeading}{#1}%
 \ifdim\mTwentyTitleHalfHeight>95bp\mTwentyMakeOpenerTitle{48bp}{45bp}{#1}\fi
 \ifdim\mTwentyTitleHalfHeight>95bp\mTwentyMakeOpenerTitle{42bp}{39bp}{#1}\fi
 \AddToHookNext{shipout/background}{\put(0,-\paperheight){\includegraphics[width=\paperwidth,height=\paperheight]{\mTwentyAssetPath chapter-opener.original-template.pdf}}}%
 \AddToHookNext{shipout/foreground}{\begingroup\put(0,-202.325bp){\makebox[\paperwidth][l]{\hspace{\mTwentyInner}\makebox[\textwidth][c]{\raisebox{-\mTwentyTitleHalfHeight}[0pt][0pt]{\copy\mTwentyChapterTitleBox}}}}\endgroup}%
 \vbox to\dimexpr\mTwentyOpenerBodyTop-\mTwentyTop-\topskip\relax{\null\vfil}%
}
\let\@makeschapterhead\@makechapterhead
\newif\ifmTwentyFirstRestore
\def\@afterheading{\@nobreaktrue\everypar{%
 \if@nobreak\@nobreakfalse\clubpenalty\@M
  \if@afterindent\else{\setbox\z@\lastbox}%
   \edef\mTwentyCurrentFamily{\f@family}\edef\mTwentyBodyFamily{\rmdefault}%
   \ifx\mTwentyCurrentFamily\mTwentyBodyFamily\mTwentyFirstFont\mTwentyFirstRestoretrue\fi
  \fi
 \else\clubpenalty\@clubpenalty\everypar{}\fi}}
\AddToHook{para/end}{\ifmTwentyFirstRestore\ifmTwentySidebarActive\else\mTwentyFirstRestorefalse\rmfamily\fi\fi}
% Original sb 1/sb bullet gold text swatch; dark gold remains in authentic frame gradients.
\definecolor{m20gold}{cmyk}{.1144,.1735,.6863,0}
\definecolor{m20framedark}{cmyk}{.2888,.4368,.8328,.0635}
\definecolor{m20purple}{cmyk}{.8549,1,.2161,.1239}
% Original footer: baseline y=736.81bp; outer folio and inward-facing runner.
\newcommand\mTwentyFooterText[1]{{\mTwentyHeadingFont\fontsize{10bp}{10bp}\selectfont\scalebox{.8}[1]{#1}}}
\newcommand\mTwentyFooterRunner[1]{\begingroup\setbox\z@=\hbox{\mTwentyFooterText{#1}}\ifdim\wd\z@>390bp\resizebox{390bp}{!}{\box\z@}\else\box\z@\fi\endgroup}
\def\ps@mTwenty{\let\@oddhead\@empty\let\@evenhead\@empty
 \def\@oddfoot{\hfil\mTwentyFooterRunner{\mTwentyChapterRunningTitle}\makebox[35.77bp][r]{\mTwentyFooterText{\thepage}}}%
 \def\@evenfoot{\makebox[33.9bp][l]{\mTwentyFooterText{\thepage}}\mTwentyFooterRunner{\mTwentyRunningTitle}\hfil}}
\let\ps@plain\ps@mTwenty\pagestyle{mTwenty}
\AddToHook{shipout/background}{\ifmTwentyBlankPage\else
 \ifmTwentyInteriorTitlePage
  \put(0,-\paperheight){\includegraphics{\mTwentyAssetPath interior-title.original-template.pdf}}%
 \else\ifmTwentyOpenerPage
  \put(0,-\paperheight){\includegraphics[width=\paperwidth,height=\paperheight]{\mTwentyAssetPath page_border.png}}%
 \else
  \put(0,-\paperheight){\includegraphics[page=\ifodd\c@page2\else1\fi]{\mTwentyAssetPath spread-border.original-template.pdf}}%
 \fi\fi\fi}
\AddToHook{shipout/after}{\global\mTwentyBlankPagefalse\global\mTwentyOpenerPagefalse\global\mTwentyInteriorTitlePagefalse\ifmTwentyArtReverse\global\let\mc@align@columns\LR@column@boxes\global\mTwentyArtReversefalse\fi}
\newcommand\mTwentyInteriorTitle[2]{%
 \hypersetup{pdfpagelayout=TwoPageRight,pdftitle={#1}}%
 \mTwentyBodyEnd\clearpage\global\mTwentyInteriorTitlePagetrue\thispagestyle{empty}%
 \AddToHookNext{shipout/foreground}{%
  \put(0,-136.08bp){\makebox[\paperwidth][c]{\raisebox{-.5\height}[0pt][0pt]{\parbox{490bp}{\centering\mTwentyHeadingControls\mTwentyHeadingFont\fontsize{48bp}{48bp}\selectfont\color{m20gold}#1}}}}%
  \put(0,-700bp){\makebox[\paperwidth][c]{\parbox{490bp}{\centering\mTwentyFirstFont\fontsize{14bp}{17bp}\selectfont\color{m20gold}#2}}}}
 \null\newpage}
\newcommand\mTwentyInteriorCredits[1]{%
 \mTwentyBodyEnd\clearpage\thispagestyle{mTwenty}%
 \begingroup\mTwentyFirstFont\fontsize{10bp}{12bp}\selectfont\parindent=0bp\parskip=1.44bp
 \renewcommand\section[1]{\par\phantomsection\addcontentsline{toc}{section}{##1}{\mTwentyFirstFont\bfseries\fontsize{11bp}{13bp}\selectfont\color{m20purple}##1\par}\vskip7.2bp}%
 \noindent\begin{minipage}[t]{\mTwentyColumnWidth}#1\end{minipage}\par\endgroup\newpage}
\newdimen\mTwentyArtWidth
\newdimen\mTwentyArtHeight
\newcommand\mTwentyArtBox{%
 \begin{tikzpicture}[baseline=0bp]
  \path[use as bounding box] (0,0) rectangle (\mTwentyArtWidth,\mTwentyArtHeight);
  \def\mTwentyVertical{vertical}%
  \ifx\mTwentyArtKind\mTwentyVertical
   \node[inner sep=0bp,anchor=north west] at (-2.5bp,\dimexpr\mTwentyArtHeight+2.5399bp) {\includegraphics[width=\dimexpr\mTwentyArtWidth+14.0507bp,height=\dimexpr\mTwentyArtHeight+14.0798bp]{\mTwentyAssetPath art-vertical.original-template.pdf}};
  \else
   \node[inner sep=0bp,anchor=north west] at (-2.5bp,\mTwentyArtHeight) {\includegraphics[width=\dimexpr\mTwentyArtWidth+13.86bp,height=\mTwentyArtHeight]{\mTwentyAssetPath art-horizontal.original-template.pdf}};
  \fi
  \ifx\mTwentyArtImage\@empty
   \node[inner sep=0bp,text width=\dimexpr\mTwentyArtWidth-20bp,align=center,text=\ifx\mTwentyArtKind\mTwentyVertical black\else white\fi] at (.5\mTwentyArtWidth,.5\mTwentyArtHeight) {\mTwentyFirstFont\fontsize{20bp}{24bp}\selectfont Place illustration here\par{\fontsize{11bp}{14bp}\selectfont (recommended full colour)}};
  \else
   \node[inner sep=0bp] at (.5\mTwentyArtWidth,.5\mTwentyArtHeight) {\includegraphics[width=\dimexpr\mTwentyArtWidth-14bp\relax,height=\dimexpr\mTwentyArtHeight-40bp\relax,keepaspectratio]{\mTwentyArtImage}};
   \node[inner sep=0bp,anchor=south,text width=\dimexpr\mTwentyArtWidth-14bp\relax,align=center] at (.5\mTwentyArtWidth,7bp) {\fontsize{8bp}{10bp}\selectfont\mTwentyArtCaption\space\mTwentyArtCredit};
  \fi
  \node[inner sep=0bp,outer sep=0bp,minimum size=0bp,anchor=north west] at (0,\mTwentyArtHeight) {\mTwentyPosition{\mTwentyArtID}{\mTwentyArtWidth}{\mTwentyArtWidth}{1}{art}{0}{\mTwentyArtPlace}{\mTwentyArtHeight}};
 \end{tikzpicture}%
}
\newcommand\mTwentyArtPDF{%
 \par
 \def\mTwentyVertical{vertical}\def\mTwentyHere{here}\def\mTwentyNextPage{next-page}\def\mTwentyBottom{bottom}\def\mTwentyOuterPosition{outer}%
 \ifx\mTwentyArtPlace\mTwentyNextPage\newpage\fi
 \mTwentyArtWidth=\textwidth\mTwentyArtHeight=341.28bp
 \ifx\mTwentyArtKind\mTwentyVertical
  \mTwentyBodyEnd
  \mTwentyArtWidth=\mTwentyColumnWidth
  % Use a substantial remaining side region where it exists; a tall reserve
  % need not strand a preceding paragraph merely to recover the full 657bp.
  \mTwentyRemaining
  \ifdim\mTwentyAvailable<360bp
   \ifx\mTwentyArtPlace\mTwentyHere\PackageError{m20}{M20_E_PLACEMENT_UNAVAILABLE}{A vertical art reserve needs at least 360bp here.}\else\newpage\fi
  \fi
  \mTwentyBodyBegin
  % Multicol has now removed any real top/bottom float space. Reserve only
  % that page's live column height, leaving the original frame's shadow clear.
  \mTwentyArtHeight=\dimexpr\@colroom-14bp\relax
  % The outside default is left on verso and right on recto. Reverse this
  % page only; shipout restores the ordinary column reading direction.
  \ifodd\c@page
   \ifx\mTwentyArtPosition\mTwentyOuterPosition\RLmulticolcolumns\global\mTwentyArtReversetrue\fi
  \else\ifx\mTwentyArtPosition\mTwentyOuterPosition\else\RLmulticolcolumns\global\mTwentyArtReversetrue\fi\fi
  \noindent\mTwentyArtBox\par\columnbreak
 \else
  % Native t/b-only floats reserve the page edge. Deliberately omit p so
  % interior art does not become a half-page on an otherwise empty float page.
  \ifx\mTwentyArtPosition\mTwentyBottom
   \begin{figure*}[!b]\noindent\mTwentyArtBox\par\end{figure*}%
  \else
   \begin{figure*}[!t]\noindent\mTwentyArtBox\par\end{figure*}%
  \fi
  \mTwentyBodyBegin
 \fi
}
