\newcommand\mTwentyInteriorCredits[1]{%
 \mTwentyBodyEnd\clearpage\thispagestyle{mTwenty}%
 \AddToHookNext{shipout/foreground}{%
  \put(0,-\paperheight){\includegraphics{\mTwentyAssetPath credits-legal.original-template.pdf}}%
  \put(290.8004bp,-639.7725bp){\makebox[0bp][l]{\mTwentyFirstFont\mdseries\fontsize{10bp}{12bp}\selectfont\color[cmyk]{0,0,0,1}\scalebox{.9429}[.98]{\mTwentyCopyrightYearText}}}}%
 \begingroup\mTwentyFirstFont\fontsize{10bp}{12bp}\selectfont\parindent=0bp\parskip=1.44bp
 % Source anchors/attributions remain, but Credits has no Contents entry.
 \renewcommand\section[1]{\par\phantomsection}%
 \noindent\begin{minipage}[t]{\mTwentyColumnWidth}
  {\mTwentyHeadingFont\mdseries\fontsize{12bp}{14bp}\selectfont Credits\par}
  \textbf{Written By:} \mTwentyWrittenByText\par
  \textbf{Developed By:} \mTwentyDevelopedByText\par
  \textbf{Edited By:} \mTwentyEditedByText\par\vskip9bp
  #1
 \end{minipage}\hspace{\mTwentyGutter}%
 \begin{minipage}[t]{\mTwentyColumnWidth}
  {\mTwentyHeadingFont\mdseries\fontsize{12bp}{14bp}\selectfont Special Thanks to:\par}
  \mTwentySpecialThanksText\par
 \end{minipage}\par\endgroup\newpage}
% Chapter TOC entries use the template's purple Abbess role. The number is
% consumed as words inside the title, rather than a detached numeral column.
\ExplSyntaxOn
\cs_new:Npn \mTwentyChapterWord #1 {\str_case:nnF {#1}
 {{1}{One}{2}{Two}{3}{Three}{4}{Four}{5}{Five}{6}{Six}{7}{Seven}{8}{Eight}{9}{Nine}{10}{Ten}{11}{Eleven}{12}{Twelve}}{#1}}
\ExplSyntaxOff
\newcommand\mTwentyTOCChapterPrefix[1]{%
 \def\mTwentyTOCValue{#1}\def\mTwentyTOCA{A}\def\mTwentyTOCB{B}%
 \ifx\mTwentyTOCValue\mTwentyTOCA Appendix A:\space
 \else\ifx\mTwentyTOCValue\mTwentyTOCB Appendix B:\space
 \else Chapter \mTwentyChapterWord{#1}:\space\fi\fi}
\renewcommand*\l@chapter[2]{%
 \ifnum\c@tocdepth>\m@ne
  \addpenalty{-\@highpenalty}\vskip1em\@plus\p@
  \begingroup\mTwentyHeadingFont\mdseries\let\textbf\@firstofone\fontsize{12bp}{14bp}\selectfont\color{m20purple}%
   \let\numberline\mTwentyTOCChapterPrefix
   \def\@pnumwidth{2em}% three-digit Abbess folios need their true width
   \leftskip=0bp\rightskip=\@tocrmarg plus 1fil\parfillskip=-\@tocrmarg
   \parindent=0bp\interlinepenalty=\@M\leavevmode
   #1\nobreak\leaders\hbox{$\m@th\mkern\@dotsep mu\hbox{.}\mkern\@dotsep mu$}\hfill
   \nobreak\hb@xt@\@pnumwidth{\hfil #2}\par
  \endgroup
 \fi}
\newdimen\mTwentyArtWidth
\newdimen\mTwentyArtHeight
% Art uses a distinct native wide-float type so its edge constraint does not
% reduce ordinary tables' ability to stack. Multicols supplies the wide-float
% enqueue operation; no body region is ended merely to insert horizontal art.
\def\ftype@mTwentyHorizontalArt{4}
\newenvironment{mTwentyHorizontalArt}[1]{\@dblfloat{mTwentyHorizontalArt}[#1]}{\end@dblfloat}
\let\mTwentyNativeAddTopOrBottom\@addtotoporbot
\def\@addtotoporbot{%
 \ifnum\@currtype=128\relax
  \@getfpsbit\tw@
  \ifodd\@tempcnta
   \ifx\@toplist\@empty\mTwentyNativeAddTopOrBottom\fi
  \else\mTwentyNativeAddTopOrBottom\fi
 \else\mTwentyNativeAddTopOrBottom\fi}
% Once bottom art is admitted, later bottom floats must wait rather than
% pushing that illustration upward away from the page's bottom edge.
\let\mTwentyNativeAddToBottom\@addtobot
\def\@addtobot{%
 \@bitor{128}\@botlist
 \if@test\else\mTwentyNativeAddToBottom\fi}
% Clearpage can build a forced float-only page even without a p specifier.
% Reject art as a later float there too; its standalone page starts at the
% existing zero fptop instead of underneath an earlier table.
\let\mTwentyNativeFloatPageCandidate\@ztryfc
\def\@ztryfc#1{%
 \@tempcnta\count#1\divide\@tempcnta\@xxxii
 \ifnum\@tempcnta=4\relax
  \ifx\@flsucceed\@empty\mTwentyNativeFloatPageCandidate{#1}%
  \else\@cons\@flfail#1\fi
 \else\mTwentyNativeFloatPageCandidate{#1}\fi}
\newcommand\mTwentyArtBox{%
 \begin{tikzpicture}[baseline=0bp]
  \path[use as bounding box] (0,0) rectangle (\mTwentyArtWidth,\mTwentyArtHeight);
  \def\mTwentyVertical{vertical}%
  \ifx\mTwentyArtKind\mTwentyVertical
   \node[inner sep=0bp,anchor=north west] at (-2.5bp,\dimexpr\mTwentyArtHeight+2.5399bp) {\includegraphics[width=\dimexpr\mTwentyArtWidth+14.0507bp,height=\dimexpr\mTwentyArtHeight+14.0798bp]{\mTwentyAssetPath art-vertical.original-template.pdf}};
  \else
   \node[inner sep=0bp,anchor=north west] at (-2.5bp,\mTwentyArtHeight) {\includegraphics[width=\dimexpr\mTwentyArtWidth+13.86bp,height=\mTwentyArtHeight]{\mTwentyAssetPath art-horizontal.original-template.pdf}};
  \fi
  \ifx\mTwentyArtImage\@empty
   \node[inner sep=0bp,text width=\dimexpr\mTwentyArtWidth-20bp,align=center,text=\ifx\mTwentyArtKind\mTwentyVertical black\else white\fi] at (.5\mTwentyArtWidth,.5\mTwentyArtHeight) {\mTwentyFirstFont\fontsize{20bp}{24bp}\selectfont Place illustration here\par{\fontsize{11bp}{14bp}\selectfont (recommended full colour)}};
  \else
   \node[inner sep=0bp] at (.5\mTwentyArtWidth,.5\mTwentyArtHeight) {\includegraphics[width=\dimexpr\mTwentyArtWidth-14bp\relax,height=\dimexpr\mTwentyArtHeight-40bp\relax,keepaspectratio]{\mTwentyArtImage}};
   \node[inner sep=0bp,anchor=south,text width=\dimexpr\mTwentyArtWidth-14bp\relax,align=center] at (.5\mTwentyArtWidth,7bp) {\fontsize{8bp}{10bp}\selectfont\mTwentyArtCaption\space\mTwentyArtCredit};
  \fi
  \node[inner sep=0bp,outer sep=0bp,minimum size=0bp,anchor=north west] at (0,\mTwentyArtHeight) {\mTwentyPosition{\mTwentyArtID}{\mTwentyArtWidth}{\mTwentyArtWidth}{1}{art}{0}{\mTwentyArtPlace}{\mTwentyArtHeight}};
 \end{tikzpicture}%
}
\newcommand\mTwentyArtPDF{%
 \par
 \def\mTwentyVertical{vertical}\def\mTwentyHere{here}\def\mTwentyNextPage{next-page}\def\mTwentyBottom{bottom}\def\mTwentyOuterPosition{outer}%
 \ifx\mTwentyArtPlace\mTwentyNextPage\newpage\fi
 \mTwentyArtWidth=\textwidth\mTwentyArtHeight=341.28bp
 \ifx\mTwentyArtKind\mTwentyVertical
  \mTwentyBodyEnd\clearpage
  % The template's vertical frame is a full text-area column, not a shorter
  % remainder box. Pending full-width floats must ship before this page.
  \mTwentyArtWidth=\mTwentyColumnWidth\mTwentyArtHeight=\textheight
  \global\mTwentyArtColumnActivetrue\mTwentyBodyBegin
  % The outside default is left on verso and right on recto. Reverse this
  % page only; shipout restores the ordinary column reading direction.
  \ifodd\c@page
   \ifx\mTwentyArtPosition\mTwentyOuterPosition\RLmulticolcolumns\global\mTwentyArtReversetrue\fi
  \else\ifx\mTwentyArtPosition\mTwentyOuterPosition\else\RLmulticolcolumns\global\mTwentyArtReversetrue\fi\fi
  \noindent\mTwentyArtBox\par\columnbreak
 \else
  % Native t/b-only floats reserve the page edge. Deliberately omit p so
  % interior art does not become a half-page on an otherwise empty float page.
  \ifx\mTwentyArtPosition\mTwentyBottom
   \begin{mTwentyHorizontalArt}{!b}\noindent\mTwentyArtBox\par\end{mTwentyHorizontalArt}%
  \else
   \begin{mTwentyHorizontalArt}{!t}\noindent\mTwentyArtBox\par\end{mTwentyHorizontalArt}%
  \fi
  \mTwentyBodyBegin
 \fi
}
