% Strong endpoint protection is reapplied after each body region and heading.
\newcommand\mTwentyParagraphControls{%
 \clubpenalty=10000\widowpenalty=10000\displaywidowpenalty=10000\@clubpenalty=10000%
 \hyphenpenalty=650\exhyphenpenalty=300\doublehyphendemerits=50000\finalhyphendemerits=10000%
 \tolerance=3000\emergencystretch=24bp}
\newcommand\mTwentyHeadingControls{\hyphenpenalty=10000\exhyphenpenalty=10000}
\renewcommand\mTwentyBodyBegin{\color{black}\ifmTwentyBodyActive\else\par\ifdim\pagetotal>\dimexpr\textheight-24bp\relax\newpage\fi\global\mTwentyBodyActivetrue\begin{multicols}{2}\mTwentyParagraphControls\raggedcolumns\fi}
\renewcommand\mTwentyBodyEnd{\ifmTwentyBodyActive\par\end{multicols}\global\mTwentyBodyActivefalse\fi\@nobreakfalse\@noskipsecfalse\everypar{}}
\newcommand\mTwentySuspendEnvironment[1]{\ifmTwentyBodyActive\endgroup\mTwentyBodyEnd\begingroup\def\@currenvir{#1}\fi}
\renewcommand\mTwentyNewPage{\mTwentyBodyEnd\clearpage\mTwentyBodyBegin}
\newwrite\mTwentyPositionStream
\AtBeginDocument{\mTwentyLoadFonts\fontsize{10bp}{12bp}\selectfont\mTwentyParagraphControls\raggedbottom\immediate\openout\mTwentyPositionStream=\jobname.m20pos\relax\mTwentyBodyBegin}
\AtEndDocument{\mTwentyBodyEnd\clearpage\immediate\closeout\mTwentyPositionStream}
% Values are frozen now; page and position primitives are evaluated at shipout.
\newcommand\mTwentyPosition[8]{%
 \savepos
 \begingroup
 \edef\mTwentyWrite{\write\mTwentyPositionStream{#1|\noexpand\the\noexpand\ReadonlyShipoutCounter|\noexpand\the\noexpand\lastxpos|\noexpand\the\noexpand\lastypos|\number\dimexpr#2\relax|\number\dimexpr#3\relax|#4|#5|#6|#7|\number\dimexpr#8+0bp\relax|\noexpand\thepage|\noexpand\number\noexpand\c@page}}%
 \mTwentyWrite\endgroup}
\renewcommand\mTwentyAnchor[1]{%
 \mTwentyPosition{#1}{\linewidth}{\linewidth}{1}{anchor}{0}{flow}{}%
 % Zero-height semantic writes must not introduce a new break between a
 % native heading's no-break guard and its first actual paragraph line.
 \ifvmode\if@nobreak\nobreak\fi\fi}
\renewcommand\@seccntformat[1]{}
\renewcommand\@startsection[6]{\if@noskipsec\leavevmode\fi\par\@tempskipa #4\relax\@afterindenttrue\ifdim\@tempskipa<\z@\@tempskipa-\@tempskipa\@afterindentfalse\fi\if@nobreak\everypar{}\else\addpenalty\@secpenalty\addvspace\@tempskipa\fi\@ifstar{\@ssect{#3}{#4}{#5}{#6}}{\@dblarg{\@sect{#1}{#2}{#3}{#4}{#5}{#6}}}}
\renewcommand\section{\@startsection{section}{1}{\z@}{7.2bp}{2.1528bp}{\centering\mTwentyHeadingControls\mTwentyHeadingFont\mdseries\let\textbf\@firstofone\fontsize{24bp}{25bp}\selectfont}}
% Wrap the styled native section only after defining its style.
\let\mTwentyStyledSection\section
\newcommand\mTwentySectionBody[3]{%
 \IfBooleanTF{#1}{\mTwentyStyledSection*{#3}}{\IfNoValueTF{#2}{\mTwentyStyledSection{#3}}{\mTwentyStyledSection[#2]{#3}}}%
}
\RenewDocumentCommand\section{s o m}{%
 \ifmTwentyArtColumnActive
  % A full-height side reserve owns the other column on this page. Keep the
  % section and its following text in the live narrative column beside it.
  \mTwentyKeepHeading{90bp}\addvspace{13.5bp}\noindent
  \mTwentyPosition{span-heading}{\linewidth}{\linewidth}{1}{heading}{0}{flow}{}%
  \mTwentySectionBody{#1}{#2}{#3}\vspace{1.8bp}\hrule width\linewidth height1.25bp\vspace{13.5bp}%
 \else
  \mTwentyBodyEnd\mTwentyRemaining\ifdim\mTwentyAvailable<108bp\relax\newpage\fi
  \addvspace{13.5bp}\noindent\mTwentyPosition{span-heading}{\textwidth}{\textwidth}{2}{heading}{0}{flow}{}%
  \mTwentySectionBody{#1}{#2}{#3}\vspace{1.8bp}\hrule height1.25bp\vspace{13.5bp}\mTwentyBodyBegin
 \fi
 \@afterindentfalse\@afterheading}
\newcommand\mTwentyKeepHeading[1]{\mTwentyRemaining\ifdim\mTwentyAvailable<#1\relax\ifmTwentyBodyActive\columnbreak\else\newpage\fi\fi}
\renewcommand\subsection{\mTwentyKeepHeading{54bp}\@startsection{subsection}{2}{\z@}{7.2bp}{0.01bp}{\raggedright\mTwentyHeadingControls\mTwentyHeadingNarrowFont\mdseries\let\textbf\@firstofone\fontsize{18bp}{18bp}\selectfont}}
\renewcommand\subsubsection{\mTwentyKeepHeading{42bp}\@startsection{subsubsection}{3}{\z@}{7.2bp}{0.01bp}{\raggedright\mTwentyHeadingControls\mTwentyHeadingFont\mdseries\let\textbf\@firstofone\fontsize{12bp}{14bp}\selectfont}}
\newif\ifmTwentyNumberedOpener
\let\mTwentyOriginalChapter\chapter
\RenewDocumentCommand\chapter{s o m}{%
 \mTwentyBodyEnd\clearpage
 \IfBooleanTF{#1}{\gdef\mTwentyChapterRunningTitle{#3}}{\IfNoValueTF{#2}{\gdef\mTwentyChapterRunningTitle{#3}}{\gdef\mTwentyChapterRunningTitle{#2}}}
 \mTwentyCheckMainMatterFacing
 % Contents follows Credits; chapter-facing illustration leaves remain blank-free art.
 \def\mTwentyFrontOpening{0}%
 \IfBooleanT{#1}{\if@mainmatter\else\def\mTwentyFrontOpening{1}\fi}%
 \ifnum\mTwentyFrontOpening=1
  \ifodd\c@page\else\null\thispagestyle{mTwenty}\newpage\fi
 \else
  \ifnum\mTwentyNeedChapterFacing=1
   \ifodd\c@page\null\thispagestyle{mTwenty}\newpage\fi
   \mTwentyChapterFacingIllustration
  \fi
 \fi
 \global\mTwentyHadChaptertrue
 \IfBooleanTF{#1}{\mTwentyNumberedOpenerfalse\mTwentyOriginalChapter*{#3}}{\mTwentyNumberedOpenertrue\IfNoValueTF{#2}{\mTwentyOriginalChapter{#3}}{\mTwentyOriginalChapter[#2]{#3}}}%
 \mTwentyBodyBegin\@afterindentfalse\@afterheading}
\newbox\mTwentyChapterTitleBox
\newdimen\mTwentyTitleHalfHeight
\newdimen\mTwentyTitleTextWidth
\newcommand\mTwentyMakeOpenerTitle[3]{%
 \setbox\mTwentyChapterTitleBox=\vbox{\hsize=\mTwentyTitleTextWidth\parindent\z@\centering\mTwentyHeadingFont\mdseries\let\textbf\@firstofone\fontsize{#1}{#2}\selectfont\hyphenpenalty=10000\exhyphenpenalty=10000
  \begingroup\color{m20gold}\ifmTwentyNumberedOpener\if@mainmatter\ifnum\c@secnumdepth>\m@ne\@chapapp\space\thechapter:\par\fi\fi\fi #3\par\endgroup}%
 \mTwentyTitleHalfHeight=\ht\mTwentyChapterTitleBox\advance\mTwentyTitleHalfHeight\dp\mTwentyChapterTitleBox\divide\mTwentyTitleHalfHeight2
}
\def\@makechapterhead#1{%
 \global\mTwentyOpenerPagetrue
 \mTwentyTitleTextWidth=\dimexpr\textwidth-40bp\relax
 \mTwentyMakeOpenerTitle{\mTwentyChapterTitleSize}{\mTwentyChapterTitleLeading}{#1}%
 \ifdim\mTwentyTitleHalfHeight>95bp\mTwentyMakeOpenerTitle{48bp}{45bp}{#1}\fi
 \ifdim\mTwentyTitleHalfHeight>95bp\mTwentyMakeOpenerTitle{42bp}{39bp}{#1}\fi
 \AddToHookNext{shipout/background}{\put(0,-\paperheight){\includegraphics[width=\paperwidth,height=\paperheight]{\mTwentyAssetPath chapter-opener.original-template.pdf}}}%
 \AddToHookNext{shipout/foreground}{\begingroup\put(0,-202.325bp){\makebox[\paperwidth][l]{\hspace{\mTwentyInner}\makebox[\textwidth][c]{\raisebox{-\mTwentyTitleHalfHeight}[0pt][0pt]{\copy\mTwentyChapterTitleBox}}}}\endgroup}%
 \vbox to\dimexpr\mTwentyOpenerBodyTop+\mTwentyChapterBodyGap-\mTwentyTop-\topskip\relax{\null\vfil}%
}
\let\@makeschapterhead\@makechapterhead
\newif\ifmTwentyFirstRestore
\def\@afterheading{\@nobreaktrue\everypar{%
 \if@nobreak\@nobreakfalse\clubpenalty\@M
  \if@afterindent\else{\setbox\z@\lastbox}%
   \edef\mTwentyCurrentFamily{\f@family}\edef\mTwentyBodyFamily{\rmdefault}%
   \ifx\mTwentyCurrentFamily\mTwentyBodyFamily\mTwentyFirstFont\mTwentyFirstRestoretrue\fi
  \fi
 \else\clubpenalty\@clubpenalty\everypar{}\fi}}
\AddToHook{para/end}{\ifmTwentyFirstRestore\ifmTwentySidebarActive\else\mTwentyFirstRestorefalse\rmfamily\fi\fi}
